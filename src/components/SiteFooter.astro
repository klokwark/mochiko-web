---
import { navigation, socials } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-shell">
    <div class="footer-console">
      <div class="footer-console__bar"><span><i class="ph-fill ph-heart" aria-hidden="true"></i> end_of_page</span><div aria-hidden="true"><i></i><i></i><i></i></div></div>
      <div class="footer-console__body">
        <div class="footer-console__hello">
          <p>you made it!!</p>
          <h2>okay bye,<br /><em>see u soon ♡</em></h2>
          <div class="footer-console__buttons">
            <a class="button button--pink" href="https://www.youtube.com/@mochikotv" target="_blank" rel="noreferrer"><i class="ph-fill ph-youtube-logo" aria-hidden="true"></i> YouTube</a>
            <a class="button footer-console__kofi" href="https://ko-fi.com/mochikotv" target="_blank" rel="noreferrer"><i class="ph-fill ph-coffee" aria-hidden="true"></i> Ko-fi</a>
            <a class="button footer-console__twitch" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer"><i class="ph-fill ph-twitch-logo" aria-hidden="true"></i> Twitch</a>
          </div>
        </div>

        <nav class="footer-map" aria-label="Footer navigation">
          {navigation.map((item, index) => <a href={item.href}><span>0{index + 1}</span><strong>{item.label}</strong><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>)}
        </nav>

        <div class="footer-connect">
          <span>find me over here</span>
          <div>
            {socials.map((social) => (
              <a class="footer-social" href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}>
                <i class:list={["ph", social.icon]} aria-hidden="true"></i>
              </a>
            ))}
          </div>
        </div>
      </div>
      <img class="footer-sitter" src="/assets/cute-pose-1.webp" alt="Mochiko sitting with a bunny plush" width="1086" height="1448" loading="lazy" />
    </div>

    <div class="footer-bottom">
      <p>© {year} Mochiko</p>
      <p class="footer-legal">art by klokwark ୨୧ <a href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">Jannik</a> <a href="/privacy">privacy</a> <a href="https://www.jannikjbi.de/impressum" target="_blank" rel="noreferrer">impressum</a></p>
    </div>
  </div>
</footer>
