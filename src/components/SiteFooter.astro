---
import { socials, playlist } from "../data/site";
---
<footer class="site-footer">
  <a class="footer-mark" href="/"><span class="accent" aria-hidden="true">✿</span>Mochiko.</a>
  <p>okay bye, see u soon ♡</p>
  <nav class="footer-socials" aria-label="Footer social links">{socials.map(social => <a href={social.href} target="_blank" rel="noreferrer">{social.label}</a>)}<a href={playlist.href} target="_blank" rel="noreferrer">Spotify</a></nav>
  <p>© {new Date().getFullYear()} Mochiko · art by klokwark</p>
  <p class="theme-credit">Based on <a href="https://github.com/sudoriaa/Kanade-Astro/tree/codex/astro-theme" target="_blank" rel="noreferrer">Kanade</a> by <a href="https://github.com/sudoriaa" target="_blank" rel="noreferrer">sudoriaa</a> · made with Astro</p>
  <div class="footer-legal"><a href="/privacy">Privacy</a><button type="button" data-open-privacy>Privacy choices</button><a href="https://www.jannikjbi.de/impressum" target="_blank" rel="noreferrer">Impressum</a></div>
</footer>
