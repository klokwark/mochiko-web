---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
  index: string;
}

const { eyebrow, title, accent, description, index } = Astro.props;
---

<section class="page-intro">
  <div class="shell relative min-w-0 py-16 sm:py-20 lg:py-28">
    <span class="page-index" aria-hidden="true">{index}</span>
    <div class="relative z-10 grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.55fr)] lg:items-end">
      <div class="min-w-0">
        <p class="section-kicker">{eyebrow}</p>
        <h1 class="page-title mt-5">{title}<br /><em>{accent}</em></h1>
      </div>
      <p class="max-w-md border-l-2 border-ink pl-5 text-base leading-relaxed font-semibold text-ink/65 sm:text-lg">{description}</p>
    </div>
  </div>
</section>
