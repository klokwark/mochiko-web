---
interface Props {
  eyebrow: string;
  title: string;
  accent: string;
  description: string;
}

const { eyebrow, title, accent, description } = Astro.props;
---

<section class="page-intro">
  <span class="page-intro__heart page-intro__heart--one" aria-hidden="true">♡</span>
  <span class="page-intro__heart page-intro__heart--two" aria-hidden="true">♡</span>
  <div class="shell relative z-10 py-14 sm:py-18 lg:py-24">
    <div class="page-intro__card">
      <p class="section-kicker">{eyebrow}</p>
      <h1 class="page-title mt-4">{title}<br /><em>{accent}</em></h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed font-bold text-ink/62 sm:text-lg">{description}</p>
    </div>
  </div>
</section>
