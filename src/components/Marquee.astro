---
const phrases = ["Let’s play", "Let’s sing", "Let’s be silly", "Let’s hang out"];
---

<div class="marquee" aria-label="Let’s play, sing, be silly, and hang out">
  <div class="marquee__track">
    {[0, 1].map((copy) => (
      <div class="marquee__group" aria-hidden={copy === 1 ? "true" : undefined}>
        {phrases.map((phrase) => (
          <span class="marquee__item"><b>♡</b>{phrase}</span>
        ))}
      </div>
    ))}
  </div>
</div>
