---
interface Props {
  phrases?: string[];
  tone?: "night" | "pink";
}

const { phrases = ["wir sehen uns im stream", "minecraft", "neue videos", "plüschtiere", "genshin", "fuchskram"], tone = "night" } = Astro.props;
---

<div class:list={["marquee", `marquee--${tone}`]} role="marquee" aria-label={phrases.join(", ")}>
  <div class="marquee__track">
    {[0, 1].map(() => (
      <div class="marquee__group" aria-hidden="true">
        {phrases.map((phrase) => <span class="marquee__item"><b>✦</b>{phrase}</span>)}
      </div>
    ))}
  </div>
</div>
