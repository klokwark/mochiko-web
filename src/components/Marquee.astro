---
const phrases = ["let’s play", "cozy chats", "cute stuff", "come hang out"];
---

<div class="marquee" aria-label="Let’s play, chat, share cute things, and hang out">
  <div class="marquee__track">
    {[0, 1].map((copy) => (
      <div class="marquee__group" aria-hidden={copy === 1 ? "true" : undefined}>
        {phrases.map((phrase) => <span class="marquee__item"><b>♡</b>{phrase}</span>)}
      </div>
    ))}
  </div>
</div>
