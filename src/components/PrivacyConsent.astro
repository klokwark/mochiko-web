<aside class="privacy-consent" data-privacy-consent role="dialog" aria-modal="true" aria-labelledby="privacy-consent-title">
  <div class="privacy-consent__icon" aria-hidden="true"><img src="/assets/emotions/wondering.webp" alt="" width="1254" height="1254" loading="lazy" /></div>
  <div class="privacy-consent__copy">
    <strong id="privacy-consent-title">quick privacy thing!</strong>
    <p>
      <span class="privacy-consent__detail">i don’t track you (data isn’t tasty anyway). twitch and youtube only load if you say okay.</span>
      <span class="privacy-consent__summary">twitch and youtube only load if you say okay.</span>
      <a href="/privacy">more info</a>
    </p>
  </div>
  <div class="privacy-consent__actions">
    <button class="button button--pink" type="button" data-privacy-accept>okay, load them</button>
    <button class="privacy-consent__no" type="button" data-privacy-decline>no thanks</button>
  </div>
</aside>

<script>
  const privacyKey = "mochiko_privacy_choice";
  const privacyWindow = window as typeof window & { __mochikoPrivacyBound?: boolean; mochikoSyncPrivacy?: () => void };

  if (!privacyWindow.__mochikoPrivacyBound) {
    privacyWindow.__mochikoPrivacyBound = true;

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;

      const choice = target.closest("[data-privacy-accept]")
        ? "accepted"
        : target.closest("[data-privacy-decline]")
          ? "declined"
          : null;

      if (choice) {
        try { localStorage.setItem(privacyKey, choice); } catch {}
        document.documentElement.dataset.privacyChoice = choice;
        document.querySelector<HTMLElement>("[data-privacy-consent]")?.removeAttribute("data-open");
        window.dispatchEvent(new CustomEvent("mochiko:privacy-choice", { detail: { choice } }));
        return;
      }

      if (!target.closest("[data-open-privacy]")) return;
      event.preventDefault();
      document.querySelector<HTMLElement>("[data-privacy-consent]")?.setAttribute("data-open", "true");
    });
  }
</script>
