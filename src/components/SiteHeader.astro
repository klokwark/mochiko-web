---
import { navigation } from "../data/site";
const icons = ["ph-house", "ph-user-circle", "ph-play-circle", "ph-calendar-dots"];
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---
<header class="nav-header" data-site-header>
  <div class="nav-inner shell">
    <a class="brand" href="/" aria-label="Mochiko home"><img src="/assets/bunny-mark.webp" width="36" height="36" alt="" />Mochiko<span class="brand-dot">.</span></a>
    <nav id="main-navigation" aria-label="Main navigation">
      {navigation.map((item, index) => <a href={item.href} aria-current={path === item.href ? "page" : undefined}><i class:list={["ph", icons[index]]} aria-hidden="true"></i>{item.label}{item.href === "/content" && <span class="nav-live" data-nav-live hidden>LIVE</span>}</a>)}
    </nav>
    <div class="nav-actions">
      <button type="button" data-open-search aria-label="Search this site" title="Search (Ctrl / ⌘ K)"><i class="ph ph-magnifying-glass" aria-hidden="true"></i></button>
      <button type="button" data-toggle-theme aria-label="Switch color theme"><i class="ph ph-sun" aria-hidden="true"></i></button>
      <button class="menu-toggle" type="button" data-toggle-menu aria-label="Open menu" aria-expanded="false" aria-controls="main-navigation"><i class="ph ph-list" aria-hidden="true"></i></button>
    </div>
  </div>
</header>
