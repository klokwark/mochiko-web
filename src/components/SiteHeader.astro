---
import { navigation } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="shell site-header__inner">
    <a href="/" class="brand-lockup" aria-label="Mochiko home">
      <span class="brand-mark-wrap">
        <img src="/assets/bunny-mark.webp" alt="" class="brand-mark" width="224" height="224" />
      </span>
      <span class="brand-lockup__text"><b class="brand-name">Mochiko</b><small>vtuber</small></span>
    </a>

    <nav class="nav-dock" aria-label="Main navigation">
      {navigation.map((item, index) => (
        <a class:list={["nav-link", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          <span>0{index + 1}</span>{item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a class="live-button" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
        <span class="live-dot" aria-hidden="true"></span>
        <span data-live-label>Twitch</span>
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>

      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <i class="ph ph-list mobile-menu__open" aria-hidden="true"></i>
          <i class="ph ph-x mobile-menu__close" aria-hidden="true"></i>
        </summary>
        <nav class="mobile-menu__panel" aria-label="Mobile navigation">
          {navigation.map((item, index) => (
            <a class:list={["mobile-menu__link", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              <b>0{index + 1}</b><span>{item.label}</span><i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          ))}
          <a class="mobile-menu__live" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
            <i class="ph-fill ph-twitch-logo" aria-hidden="true"></i><span data-live-label>Twitch</span><i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  import { getTwitch, onPrivacyChoice } from "../scripts/live";

  onPrivacyChoice((choice) => {
    if (choice !== "accepted") {
      delete document.documentElement.dataset.live;
      return;
    }
    getTwitch()
      .then((data) => {
        const live = data.live?.isLive === true;
        if (live) document.documentElement.dataset.live = "true";
        else delete document.documentElement.dataset.live;
        document.querySelectorAll(".site-header [data-live-label]").forEach((label) => {
          label.textContent = live ? "live now!" : "Twitch";
        });
      })
      .catch(() => {});
  });
</script>
