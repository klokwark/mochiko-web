---
import { navigation } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="shell flex min-h-18 items-center justify-between gap-3 py-2 sm:min-h-20">
    <a href="/" class="brand-lockup focus-ring" aria-label="Mochiko home">
      <span class="brand-mark-wrap">
        <img src="/assets/mochiko-logo-bunny-black.webp" alt="" class="brand-mark" width="1254" height="1254" />
      </span>
      <span class="brand-name">Mochiko</span>
    </a>

    <nav class="hidden items-center gap-2 lg:flex" aria-label="Main navigation">
      {navigation.map((item) => (
        <a class:list={["nav-link focus-ring", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a class="live-button hidden sm:inline-flex" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
        <span class="live-dot" aria-hidden="true"></span>
        <span data-live-label>Twitch</span>
        <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>

      <details class="mobile-menu relative lg:hidden">
        <summary class="focus-ring grid size-11 cursor-pointer list-none place-items-center rounded-full border-2 border-ink bg-white text-xl" aria-label="Open navigation">
          <i class="ph ph-list" aria-hidden="true"></i>
        </summary>
        <nav class="mobile-menu__panel" aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a class:list={["mobile-menu__link", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              <span>{item.label}</span><i class="ph ph-heart" aria-hidden="true"></i>
            </a>
          ))}
          <a class="mobile-menu__live" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
            <span data-live-label>Twitch</span><i class="ph ph-twitch-logo" aria-hidden="true"></i>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const updateLiveNavigation = async () => {
    try {
      const response = await fetch("/api/twitch");
      if (!response.ok) return;
      const data = await response.json();
      if (!data.live?.isLive) return;
      document.documentElement.dataset.live = "true";
      document.querySelectorAll("[data-live-label]").forEach((label) => {
        label.textContent = "live now!";
      });
    } catch {
      // The normal Twitch link remains useful if the live-status service is unavailable.
    }
  };

  const maybeUpdateLiveNavigation = () => {
    if (document.documentElement.dataset.privacyChoice === "accepted") updateLiveNavigation();
  };

  maybeUpdateLiveNavigation();
  window.addEventListener("mochiko:privacy-choice", maybeUpdateLiveNavigation);
  document.addEventListener("astro:page-load", maybeUpdateLiveNavigation);
</script>
