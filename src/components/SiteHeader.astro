---
import { navigation } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) => href === "/" ? path === "/" : path.startsWith(href);
---

<header class="site-header">
  <div class="shell flex h-18 items-center justify-between gap-4 sm:h-20">
    <a href="/" class="brand-lockup focus-ring" aria-label="Mochiko home">
      <img src="/assets/mochiko-logo-bunny-black.png" alt="" class="brand-mark" width="1254" height="1254" />
      <span class="brand-name">Mochiko</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation">
      {navigation.map((item) => (
        <a class:list={["nav-link focus-ring", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a class="button button--ink hidden sm:inline-flex" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">
        <i class="ph-fill ph-circle" aria-hidden="true"></i>
        Watch live
      </a>

      <details class="mobile-menu relative lg:hidden">
        <summary class="focus-ring grid size-11 cursor-pointer list-none place-items-center border-2 border-ink bg-white text-xl" aria-label="Open navigation">
          <i class="ph ph-list" aria-hidden="true"></i>
        </summary>
        <nav class="mobile-menu__panel" aria-label="Mobile navigation">
          {navigation.map((item) => (
            <a class:list={["mobile-menu__link", { "is-active": isActive(item.href) }]} href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
              <span>{item.label}</span>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
          <a class="mobile-menu__live" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">
            Watch live <i class="ph ph-twitch-logo" aria-hidden="true"></i>
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
