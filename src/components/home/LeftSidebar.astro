---
import { socials, favoriteGames } from "../../data/site";
---
<aside class="left-sidebar" aria-label="Meet Mochiko">
  <section class="card profile-card">
    <div class="profile-top"><span aria-hidden="true">✿</span><span class="eyebrow">NICE TO MEET YOU</span><span aria-hidden="true">✧</span></div>
    <a class="avatar-link" href="/about"><img src="/assets/mochikopfp.webp" width="100" height="100" alt="Mochiko" /></a>
    <h2>Mochiko</h2><p class="profile-role">VTuber & content creator</p>
    <p class="profile-bio">you can call me Mochi.<br />games, plushies, and too many tabs open.</p>
    <div class="profile-links"><a href="/content"><i class="ph ph-play-circle" aria-hidden="true"></i><span>watch</span></a><a href="/schedule"><i class="ph ph-calendar-dots" aria-hidden="true"></i><span>schedule</span></a><a href="/about"><i class="ph ph-heart" aria-hidden="true"></i><span>about me</span></a></div>
    <nav class="profile-social" aria-label="Mochiko’s social links">{socials.map(social => <a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}><i class:list={["ph", social.icon]} aria-hidden="true"></i></a>)}</nav>
    <a class="profile-status" href="/content#stream"><i class="ph ph-twitch-logo" aria-hidden="true"></i><span data-live-status>find me on Twitch</span></a>
  </section>
  <section class="card panel category-panel">
    <h2 class="panel-title"><i class="ph ph-game-controller" aria-hidden="true"></i>my game shelf</h2>
    {favoriteGames.slice(0, 4).map(game => <a href="/about#favorites"><span>{game.title}</span><span class="category-count">#{game.rank}</span></a>)}
    <a class="text-link" href="/about#favorites">all my favorites<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
  </section>
  <section class="card panel">
    <h2 class="panel-title"><i class="ph ph-sparkle" aria-hidden="true"></i>also into</h2>
    <div class="tag-cloud">{["plushies", "tech", "horror movies", "foxes", "city builders", "blue"].map(tag => <a class="chip" href="/about">{tag}</a>)}</div>
  </section>
</aside>
