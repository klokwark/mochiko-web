---
import { favoriteMusic, playlist, socials } from "../../data/site";
const discord = socials.find(social => social.label === "Discord")!;
---
<aside class="right-sidebar" aria-label="Music and community">
  <section class="card panel notice-card">
    <h2 class="panel-title"><i class="ph ph-chat-circle-dots" aria-hidden="true"></i>hiii, welcome!</h2>
    <p>i’m much louder online. you’ll usually find me playing games or getting distracted by something on my desk.</p>
    <a class="text-link" href="/about">a little about me<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
  </section>
  <section class="card panel music-panel">
    <h2 class="panel-title"><i class="ph ph-headphones" aria-hidden="true"></i>on repeat</h2>
    <a href={favoriteMusic.songHref} target="_blank" rel="noreferrer"><img src={favoriteMusic.songImage} width="240" height="240" alt="Bass Cannon cover" loading="lazy" /><h3>{favoriteMusic.song}</h3><p>{favoriteMusic.songDetail}</p></a>
    <a class="text-link" href={playlist.href} target="_blank" rel="noreferrer"><i class="ph ph-spotify-logo" aria-hidden="true"></i>my playlist<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
  </section>
  <section class="card panel community-panel">
    <i class="ph ph-discord-logo" aria-hidden="true"></i><h2>come say hi</h2><p>there’s a Discord, too.</p><a class="btn secondary" href={discord.href} target="_blank" rel="noreferrer">join the server<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
  </section>
</aside>
