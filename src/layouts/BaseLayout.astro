---
import "@phosphor-icons/web/regular";
import "@phosphor-icons/web/fill";
import "@fontsource-variable/fredoka";
import "@fontsource-variable/nunito";
import "../styles/global.css";
import PrivacyConsent from "../components/PrivacyConsent.astro";
import Search from "../components/header/Search.astro";
interface Props { title?: string; description?: string; robots?: string; }
const {
  title = "Mochiko | streams, videos & a little about me",
  description = "The official home of Mochiko: streams, videos, games, and an unreasonable number of plushies.",
  robots = "index, follow",
} = Astro.props;
const site = Astro.site ?? new URL("https://www.mochikotv.com");
const canonical = new URL(Astro.url.pathname, site);
const image = new URL("/assets/mochikobanner.webp", site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#fff1f1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content="Mochiko with her bunny plush" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        let theme = "light", choice = "unset";
        try {
          theme = localStorage.getItem("mochiko_theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          choice = localStorage.getItem("mochiko_privacy_choice") || "unset";
        } catch {}
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.dataset.privacyChoice = choice;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <Search />
    <PrivacyConsent />
    <button class="back-top" id="back-top" aria-label="Back to top" hidden><i class="ph ph-arrow-up" aria-hidden="true"></i></button>
    <script>
      import "../scripts/site";
      import "../scripts/media";
    </script>
  </body>
</html>
