---
import "@phosphor-icons/web/regular";
import "@phosphor-icons/web/fill";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

const {
  title = "Mochiko | VTuber",
  description = "The official home of Mochiko, a child-like catgirl VTuber streaming in English, German, and Russian.",
  image = "/assets/og-image.jpg",
  robots = "index, follow",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ff79ae" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-clip bg-cream text-ink antialiased">
    <slot />
  </body>
</html>
