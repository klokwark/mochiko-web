---
import "@phosphor-icons/web/regular";
import "@phosphor-icons/web/fill";
import "@fontsource-variable/caveat";
import "@fontsource-variable/dm-sans";
import "../styles/global.css";
import PrivacyConsent from "../components/PrivacyConsent.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

const {
  title = "Mochiko | VTuber",
  description = "The official home of Mochiko: streams, videos, games, and an unreasonable number of plushies.",
  image = "/assets/mochikobanner.jpg",
  robots = "index, follow",
} = Astro.props;

const absoluteImage = new URL(image, Astro.url.origin).href;

const pagePop = {
  forwards: {
    old: { name: "mochi-panel-out", duration: "340ms", easing: "cubic-bezier(.55,.06,.68,.19)", fillMode: "both" },
    new: { name: "mochi-panel-in", duration: "680ms", easing: "cubic-bezier(.16,1,.3,1)", fillMode: "both" },
  },
  backwards: {
    old: { name: "mochi-panel-out-back", duration: "340ms", easing: "cubic-bezier(.55,.06,.68,.19)", fillMode: "both" },
    new: { name: "mochi-panel-in-back", duration: "680ms", easing: "cubic-bezier(.16,1,.3,1)", fillMode: "both" },
  },
};
---

<!doctype html>
<html lang="en" class="scroll-smooth" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f2e7" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      if (!window.mochikoSyncPrivacy) {
        window.mochikoSyncPrivacy = function () {
          let choice = "unset";
          try { choice = localStorage.getItem("mochiko_privacy_choice") || "unset"; } catch {}
          document.documentElement.dataset.privacyChoice = choice;
          window.dispatchEvent(new CustomEvent("mochiko:privacy-choice", { detail: { choice } }));
        };
      }
      if (!window.mochikoPrivacySyncBound) {
        window.mochikoPrivacySyncBound = true;
        document.addEventListener("astro:page-load", window.mochikoSyncPrivacy);
      }
      window.mochikoSyncPrivacy();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="page-swap" transition:name="mochiko-page" transition:animate={pagePop}>
      <slot />
    </div>
    <PrivacyConsent />
  </body>
</html>
