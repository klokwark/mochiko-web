---
import "@phosphor-icons/web/regular";
import "@phosphor-icons/web/fill";
import "@fontsource-variable/fredoka";
import "@fontsource-variable/nunito";
import "../styles/global.css";
import PrivacyConsent from "../components/PrivacyConsent.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  robots?: string;
}

const {
  title = "Mochiko | VTuber",
  description = "The official home of Mochiko, with streams, videos, and everything in between.",
  image = "/assets/mochikobanner.png",
  robots = "index, follow",
} = Astro.props;

const absoluteImage = new URL(image, Astro.url.origin).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ff79ae" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      try {
        document.documentElement.dataset.privacyChoice = localStorage.getItem("mochiko_privacy_choice") || "unset";
      } catch {
        document.documentElement.dataset.privacyChoice = "unset";
      }
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen overflow-x-clip bg-paper text-ink antialiased">
    <div class="page-line" aria-hidden="true"></div>
    <slot />
    <PrivacyConsent />
  </body>
</html>
