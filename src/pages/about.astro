---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageIntro from "../components/PageIntro.astro";
import Marquee from "../components/Marquee.astro";
---

<BaseLayout title="About Mochiko | VTuber" description="Meet Mochiko, a child-like catgirl VTuber sharing cozy games, songs, and chats in English, German, and Russian.">
  <SiteHeader />
  <main>
    <PageIntro eyebrow="About me" title="Small paws," accent="big personality." description="I’m not playing a character from a distance. Mochiko is me, with all the soft-hearted excitement and silly little detours included." index="01" />

    <section class="border-y-2 border-ink bg-white">
      <div class="shell grid min-w-0 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)]">
        <div class="about-portrait">
          <img src="/assets/cute-pose2.png" alt="Mochiko making a cute pose" width="1200" height="1600" fetchpriority="high" />
          <span class="about-portrait__tag">that’s me!</span>
        </div>
        <div class="flex min-w-0 flex-col justify-center py-14 lg:px-16 lg:py-20">
          <p class="section-kicker">Hello hello</p>
          <h2 class="section-title mt-5">I’m<br /><em>Mochiko.</em></h2>
          <div class="mt-7 max-w-2xl space-y-5 text-base leading-relaxed font-semibold text-ink/68 sm:text-lg">
            <p>I’m a child-like catgirl VTuber who loves making the internet feel a little more like a sleepover. My streams are a mix of games, songs, conversations, and the kind of chaos that happens when I get way too excited.</p>
            <p>I speak English, German, and Russian. Whichever language brings you here, you’re welcome to get comfy and stay awhile.</p>
          </div>
          <dl class="mt-10 grid gap-3 sm:grid-cols-2">
            <div class="fact-block"><dt>Birthday</dt><dd>August 30th</dd></div>
            <div class="fact-block"><dt>Languages</dt><dd>EN · DE · RU</dd></div>
          </dl>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad bg-paper">
      <div class="shell grid min-w-0 gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:items-center lg:gap-20">
        <div class="min-w-0">
          <p class="section-kicker">What matters here</p>
          <h2 class="section-title mt-5">Come as<br /><em>you are.</em></h2>
          <p class="body-lede mt-7">You don’t need to know every reference or catch every stream. If you’re here to laugh, listen, or just keep me company, you’re already part of the moment.</p>
          <a class="button button--ink mt-8" href="/content">See what I stream <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="editorial-photo photo-cut photo-cut--reverse">
          <img src="/assets/red-dress-umbressa.png" alt="Mochiko in a red dress holding an umbrella" width="1200" height="1600" loading="lazy" />
          <span class="photo-label">soft / curious / silly</span>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
