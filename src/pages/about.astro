---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { favoriteGames, favoriteMusic, playlist } from "../data/site";

const [first, ...rest] = favoriteGames;
const seconds = rest.filter((game) => game.rank === "2");
const others = rest.filter((game) => game.rank !== "2");
---

<BaseLayout title="Über Mochiko | VTuber" description="Ein bisschen was über Mochiko und die Sachen, die sie mag.">
  <SiteHeader />
  <main>
    <section class="about-hero">
      <div class="shell about-hero__grid">
        <div class="about-hero__art">
          <div class="about-hero__window">
            <img src="/assets/red-dress-umbressa.webp" alt="Mochiko in einem rot-schwarzen Kleid mit einem Rüschenschirm in der Hand" width="1086" height="1448" fetchpriority="high" />
          </div>
          <span class="sticker-label about-hero__note">dieses kleid!!</span>
          <span class="about-hero__star" aria-hidden="true">✦</span>
        </div>

        <div class="about-hero__copy">
          <p class="kicker">über mich</p>
          <h1 class="title-xl about-hero__title">ich heiße<br /><em>Mochiko!</em></h1>
          <p class="pronounce"><span>ausgesprochen</span> ˈmɔtʃiːˌkoː</p>
          <p class="lede">aber nenn mich ruhig einfach mochi! ich komm aus norddeutschland, streame auf twitch und mach ab und zu youtube-videos.</p>
          <ul class="chip-row" aria-label="Dinge, die Mochiko mag">
            <li>füchse</li>
            <li>alles in blau</li>
            <li>horrorfilme</li>
            <li>aufbauspiele</li>
            <li>plüschtiere</li>
          </ul>
          <div class="button-row">
            <a class="button button--pink" href="#favorites">meine favoriten <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </section>

    <Marquee tone="pink" phrases={["füchse", "plüschtiere", "horrorfilme", "aufbauspiele", "schnelle musik", "alles in blau"]} />

    <section class="section-pad about-profile">
      <div class="shell about-profile__grid">
        <div class="about-profile__copy">
          <p class="kicker">noch ein bisschen mehr</p>
          <h2 class="title-lg">eigentlich bin ich<br /><em>voll schüchtern</em></h2>
          <p class="lede">im echten leben sag ich kaum was. im stream krieg ich den mund nicht mehr zu. frag mich nicht, wie das geht.</p>
          <ul class="about-notes">
            <li><b><i class="ph-fill ph-game-controller" aria-hidden="true"></i> spiel ich grad</b>minecraft, genshin, roblox und viel zu viele aufbauspiele</li>
            <li><b><i class="ph-fill ph-headphones" aria-hidden="true"></i> hör ich grad</b>schnellen kram mit viel bass, in letzter zeit meistens crankdat</li>
            <li><b><i class="ph-fill ph-warning-circle" aria-hidden="true"></i> gut zu wissen</b>ich liebe horrorfilme, aber horrorgames spiel ich nie im leben. und keine pferde pls</li>
          </ul>
        </div>
        <div class="about-profile__art">
          <span class="about-profile__disc" aria-hidden="true"></span>
          <img class="die-cut" src="/assets/outfits/outfit-4.webp" alt="Mochiko in ihrem schwarz-weißen Gaming-Outfit mit ihren Kopfhörern in der Hand" width="941" height="1672" loading="lazy" />
          <span class="sticker-label about-profile__stamp">stream-outfit</span>
        </div>
      </div>
    </section>

    <section class="section-pad about-files scallop-top">
      <div class="shell">
        <p class="kicker">mein schreibtisch</p>
        <h2 class="title-lg">was hier so <em>rumliegt</em></h2>
        <div class="about-files__grid">
          <img class="about-files__me die-cut" src="/assets/console-2.webp" alt="" width="1086" height="1448" loading="lazy" />
          <article class="file-window">
            <p class="file-window__bar"><i class="ph-fill ph-folder-simple" aria-hidden="true"></i> schreibtisch.txt <span aria-hidden="true"></span></p>
            <p class="file-window__body">4 plüschtiere, meine fuchstasse und ein schraubenzieher, der da schon seit wochen liegt</p>
          </article>
          <article class="file-window file-window--lilac">
            <p class="file-window__bar"><i class="ph-fill ph-file-text" aria-hidden="true"></i> mein_pc.txt <span aria-hidden="true"></span></p>
            <p class="file-window__body">meinen pc hab ich selbst gebaut!! frag mich was dazu und ich erklär dir jedes einzelne teil</p>
          </article>
          <article class="file-window file-window--pink">
            <p class="file-window__bar"><i class="ph-fill ph-floppy-disk" aria-hidden="true"></i> hilfe.txt <span aria-hidden="true"></span></p>
            <p class="file-window__body">einmal kurz alt-tab und plötzlich sind zwei stunden weg. jedes mal</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-pad about-ranking scallop-top" id="favorites">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">lieblingsspiele</p>
            <h2 class="title-lg">meine <em>top games</em></h2>
          </div>
          <p class="sticker-label about-ranking__note">zweimal #2, weil ich mich nicht entscheiden kann</p>
        </div>

        <div class="podium">
          <a class="podium__first" href={first.href} target="_blank" rel="noreferrer">
            <span class="podium__cover"><img src={first.image} alt={`Cover von ${first.title}`} width="600" height="800" loading="lazy" /></span>
            <span class="podium__rank">#{first.rank}</span>
            <strong>{first.title}</strong>
            <small>für immer meine #1</small>
          </a>

          <div class="podium__tie">
            {seconds.map((game) => (
              <a class="podium__second" href={game.href} target="_blank" rel="noreferrer">
                <span class="podium__cover"><img src={game.image} alt={`Cover von ${game.title}`} width="600" height="800" loading="lazy" /></span>
                <span class="podium__rank">#{game.rank}</span>
                <strong>{game.title}</strong>
              </a>
            ))}
            <span class="podium__tie-tag" aria-hidden="true">gleichstand</span>
          </div>

          <ol class="rank-list">
            {others.map((game) => (
              <li>
                <a href={game.href} target="_blank" rel="noreferrer">
                  <b>#{game.rank}</b>
                  <img src={game.image} alt="" width="600" height="800" loading="lazy" />
                  <span><strong>{game.title}</strong>{game.note && <small>{game.note}</small>}</span>
                  <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="section-pad about-music">
      <div class="shell">
        <div class="mixtape">
          <img class="mixtape__me" src="/assets/outfits/outfit-1.webp" alt="Mochiko hält weiße Kopfhörer in der Hand" width="941" height="1672" loading="lazy" />

          <div class="mixtape__heading">
            <p class="kicker">musik</p>
            <h2 class="title-lg">auf <em>repeat</em></h2>
            <p>hauptsache schnell und basslastig. der song hier läuft seit wochen rauf und runter</p>
          </div>

          <a class="mixtape__artist" href={favoriteMusic.artistHref} target="_blank" rel="noreferrer">
            <img src={favoriteMusic.artistImage} alt={favoriteMusic.artist} width="800" height="800" loading="lazy" />
            <span>lieblingskünstler</span>
            <strong>{favoriteMusic.artist}</strong>
          </a>

          <div class="mixtape__song">
            <a class="cassette" href={favoriteMusic.songHref} target="_blank" rel="noreferrer" aria-label={`${favoriteMusic.song} (${favoriteMusic.songDetail}) anhören`}>
              <span class="cassette__label">
                <small>seite a · lieblingssong</small>
                <strong>{favoriteMusic.song}</strong>
                <em>{favoriteMusic.songDetail}</em>
              </span>
              <span class="cassette__window" aria-hidden="true"><i></i><i></i></span>
              <img class="cassette__cover" src={favoriteMusic.songImage} alt="" width="800" height="800" loading="lazy" />
            </a>
            <div class="mixtape__links">
              <a class="button button--pink" href={favoriteMusic.songHref} target="_blank" rel="noreferrer">anhören <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
              <a class="button button--cream" href={playlist.href} target="_blank" rel="noreferrer"><i class="ph-fill ph-spotify-logo" aria-hidden="true"></i> {playlist.label}</a>
            </div>
          </div>
        </div>

        <div class="about-end">
          <span aria-hidden="true">୨୧</span>
          <p>okay, genug von mir! lust, was zu gucken?</p>
          <a class="button button--pink" href="/content">videos <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
