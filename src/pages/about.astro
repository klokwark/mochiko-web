---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
---

<BaseLayout title="About Mochiko | VTuber" description="A little bit about Mochiko and the things she likes.">
  <SiteHeader />
  <main>
    <section class="about-hero">
      <div class="shell about-hero__grid">
        <div class="about-hero__art">
          <span class="about-hero__scribble" aria-hidden="true">♡</span>
          <img class="about-hero__main-img" src="/assets/cute-pose2.png" alt="Mochiko sitting with a bunny plush" width="1122" height="1402" fetchpriority="high" />
          <div class="about-hero__mini">
            <img src="/assets/umbrella-2.png" alt="Mochiko holding an umbrella" width="1122" height="1402" />
          </div>
        </div>

        <div class="about-hero__copy">
          <p class="section-kicker">about me</p>
          <h1 class="about-hero__title">hii, i’m<br /><em>Mochiko ♡</em></h1>
          <p class="about-hero__intro">i always forget what to put on about pages, so this is the short version:</p>
          <div class="about-notes">
            <p><span>01</span> i love cute games, pretty outfits, and collecting little things.</p>
            <p><span>02</span> i change my mind halfway through picking what to play.</p>
            <p><span>03</span> sometimes i’m really focused. sometimes one tiny thing takes the whole stream.</p>
          </div>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad about-scrapbook">
      <div class="shell">
        <div class="about-scrapbook__heading">
          <p class="section-kicker">things i like</p>
          <h2 class="section-title mt-4">a few favorites</h2>
          <p>this list changes all the time btw</p>
        </div>

        <div class="favorite-collage mt-10">
          <article class="favorite-card favorite-card--one">
            <img src="/assets/gaming-3.png" alt="Mochiko in a black gaming outfit" width="1086" height="1448" loading="lazy" />
            <p>games with pretty worlds</p>
          </article>
          <article class="favorite-card favorite-card--two">
            <img src="/assets/outfit-3.png" alt="Mochiko in a black and white outfit" width="1024" height="1536" loading="lazy" />
            <p>changing outfits again</p>
          </article>
          <article class="favorite-card favorite-card--three">
            <img src="/assets/book.png" alt="Mochiko in a layered red dress" width="1086" height="1448" loading="lazy" />
            <p>black, white & pink</p>
          </article>
        </div>

        <div class="about-end-note">
          <span aria-hidden="true">୨୧</span>
          <p>that’s enough about me!! go look at the videos now ♡</p>
          <a class="button button--pink" href="/content">okay show me <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
