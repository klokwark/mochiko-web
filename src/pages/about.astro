---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { favoriteGames, favoriteMusic } from "../data/site";
---

<BaseLayout title="About Mochiko | VTuber" description="A little bit about Mochiko and the things she likes.">
  <SiteHeader />
  <main>
    <section class="about-diary-hero">
      <span class="about-diary-hero__star" aria-hidden="true">✦</span>
      <span class="about-diary-hero__heart" aria-hidden="true">♡</span>
      <div class="shell about-diary-hero__grid">
        <div class="about-diary-hero__copy">
          <p class="section-kicker">about me</p>
          <h1>my name is<br /><em>Mochiko!</em></h1>
          <p class="about-pronounce"><span>name_audio.txt</span> ˈmɔtʃiːˌkoː</p>
          <p>i never know what to put here, so i made a list.</p>
          <div class="about-diary-hero__facts">
            <span>cute games</span><span>pretty outfits</span><span>tiny collections</span><span>changing my mind</span>
          </div>
          <a class="button button--pink mt-7" href="#favorites">the important stuff <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
        </div>
        <div class="about-diary-hero__art">
          <div class="about-diary-hero__frame" aria-hidden="true"></div>
          <img src="/assets/red-dress-umbressa.png" alt="Mochiko in a red dress holding an umbrella" width="1086" height="1448" fetchpriority="high" />
          <span class="about-diary-hero__note">i picked the outfit first ♡</span>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad friend-about">
      <div class="shell friend-about__grid">
        <div class="friend-about__copy">
          <p class="section-kicker">my teammate</p>
          <h2 class="section-title mt-4">yes, that’s Jannik.<br /><em>don’t ship us.</em></h2>
          <p class="body-lede mt-6">we’re friends. we play games together. that is the whole sentence.</p>
          <a class="text-link mt-7" href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">go see his page <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
        <div class="friend-about__art">
          <span aria-hidden="true">2P</span>
          <img src="/assets/friends/mochiko-jannik-pose-2.webp" alt="Mochiko and Jannik holding game controllers" width="788" height="1400" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section-pad about-scrapbook" id="favorites">
      <div class="shell">
        <div class="about-scrapbook__heading">
          <p class="section-kicker">favorite games</p>
          <h2 class="section-title mt-4">my game ranking</h2>
          <p>yes, there are two #2s. no, i’m not fixing it.</p>
        </div>

        <div class="game-ranking mt-10">
          {favoriteGames.map((game) => (
            <a class="game-rank-card" href={game.href} target="_blank" rel="noreferrer">
              <div class="game-rank-card__cover">
                <img src={game.image} alt={`${game.title} cover`} width="600" height="800" loading="lazy" />
                <span>#{game.rank}</span>
              </div>
              <div class="game-rank-card__copy">
                <h3>{game.title}</h3>
                {game.note && <p>{game.note}</p>}
              </div>
            </a>
          ))}
        </div>

        <section class="music-detail">
          <div class="music-detail__heading">
            <p class="section-kicker">music</p>
            <h2 class="section-title mt-4">on repeat</h2>
            <p>this has been stuck in my head!!</p>
          </div>
          <a class="music-detail__artist" href={favoriteMusic.artistHref} target="_blank" rel="noreferrer">
            <img src={favoriteMusic.artistImage} alt={favoriteMusic.artist} width="1080" height="1080" loading="lazy" />
            <span>favorite artist rn</span>
            <h3>{favoriteMusic.artist}</h3>
          </a>
          <a class="music-detail__song" href={favoriteMusic.songHref} target="_blank" rel="noreferrer">
            <img src={favoriteMusic.songImage} alt={`${favoriteMusic.song} cover`} width="1000" height="1000" loading="lazy" />
            <div><span>favorite song</span><h3>{favoriteMusic.song}</h3><p>{favoriteMusic.songDetail}</p></div>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <img class="music-detail__mochiko" src="/assets/gaming-3.png" alt="Mochiko in a gaming outfit" width="1086" height="1448" loading="lazy" />
        </section>

        <div class="about-end-note">
          <span aria-hidden="true">୨୧</span>
          <p>that’s enough about me!! go look at the videos now ♡</p>
          <a class="button button--pink" href="/content">okay show me <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
