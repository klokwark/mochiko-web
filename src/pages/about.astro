---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { favoriteGames, favoriteMusic } from "../data/site";

const collections = ["plushies", "character figures", "screenshots I won’t delete", "little things for my desk"];
---

<BaseLayout title="About Mochiko | VTuber" description="Notes about Mochiko, her games, music, and favourite things.">
  <SiteHeader />
  <main>
    <section class="inner-hero">
      <div class="shell inner-hero__page">
        <div class="inner-hero__copy">
          <p class="diary-date">profile page <span>last edited whenever I noticed a typo</span></p>
          <h1>about<br /><em>Mochiko</em></h1>
          <p class="pronunciation"><span>most people say Mochi</span><b>ˈmɔtʃiːˌkoː</b></p>
          <p>I’m from northern Germany. Online I’m sarcastic, energetic and difficult to keep on one topic. Offline I’m much quieter.</p>
        </div>
        <div class="inner-hero__portrait">
          <span class="tape tape--top" aria-hidden="true"></span>
          <img src="/assets/red-dress-umbressa.webp" alt="Mochiko in a red dress holding an umbrella" width="1086" height="1448" fetchpriority="high" />
          <span class="handwritten">picked the outfit first</span>
        </div>
        <img class="inner-hero__mascot" src="/assets/diary-bunny.webp" alt="" width="866" height="900" />
      </div>
    </section>

    <section class="diary-section diary-section--blue about-notes">
      <div class="shell about-notes__grid">
        <article class="long-note">
          <p class="entry-number">the longer version</p>
          <h2>online me is<br /><em>the talkative one.</em></h2>
          <p>I can talk for hours online, especially when it’s about a game, a computer problem, or something I’ve just figured out. In person I take a while to warm up and I’m perfectly happy sitting somewhere quiet.</p>
          <p>I have ADHD, so plans change, tabs multiply, and I will start reorganising something halfway through doing something else. It makes streams unpredictable, but that is also just how my brain works.</p>
        </article>
        <aside class="sticky-stack">
          <div class="sticky-note sticky-note--pink"><span>likes</span><p>cute things, tech, horror films, bass-heavy music, collecting stuff</p></div>
          <div class="sticky-note sticky-note--cream"><span>does not like</span><p>horror games, horses, being asked for an exact location</p></div>
          <div class="sticky-note sticky-note--blue"><span>usually doing</span><p>opening a menu, changing a setting, forgetting why</p></div>
        </aside>
      </div>
    </section>

    <section class="diary-section paper-section">
      <div class="shell collection-page">
        <div class="collection-page__art">
          <span class="tape tape--top" aria-hidden="true"></span>
          <img src="/assets/cute-pose2.webp" alt="Mochiko sitting with a bunny plush" width="1122" height="1402" loading="lazy" />
        </div>
        <div class="collection-page__copy">
          <p class="entry-number">things around my room</p>
          <h2>I like collecting<br /><em>small things.</em></h2>
          <ul>{collections.map((item) => <li><i class="ph ph-check" aria-hidden="true"></i>{item}</li>)}</ul>
          <p class="handwritten">the bunny stays.</p>
        </div>
      </div>
    </section>

    <section class="diary-section diary-section--pink" id="favorites">
      <div class="shell">
        <div class="entry-heading">
          <div><p class="entry-number">games page</p><h2>the ranking<br /><em>right now</em></h2><p class="heading-note">There are two number twos. I meant it that way.</p></div>
        </div>
        <div class="ranking-grid">
          {favoriteGames.map((game) => (
            <a class="rank-scrap" href={game.href} target="_blank" rel="noreferrer">
              <span class="rank-scrap__number">{game.rank}</span>
              <img src={game.image} alt={`${game.title} cover`} width="600" height="800" loading="lazy" />
              <div><h3>{game.title}</h3>{game.note && <p>{game.note}</p>}</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="diary-section paper-section">
      <div class="shell music-page">
        <div class="music-page__copy"><p class="entry-number">music page</p><h2>energy matters<br /><em>more than genre.</em></h2><p>I jump between genres. If it’s fast, catchy and bassy, it usually survives the playlist.</p></div>
        <a class="album-scrap album-scrap--artist" href={favoriteMusic.artistHref} target="_blank" rel="noreferrer"><span class="tape tape--top" aria-hidden="true"></span><img src={favoriteMusic.artistImage} alt={favoriteMusic.artist} width="1080" height="1080" loading="lazy" /><small>favourite artist</small><b>{favoriteMusic.artist}</b></a>
        <a class="album-scrap album-scrap--song" href={favoriteMusic.songHref} target="_blank" rel="noreferrer"><span class="tape tape--top" aria-hidden="true"></span><img src={favoriteMusic.songImage} alt={`${favoriteMusic.song} cover`} width="1000" height="1000" loading="lazy" /><small>favourite song</small><b>{favoriteMusic.song}</b></a>
        <img class="music-page__pose" src="/assets/outfits/outfit-1.webp" alt="Mochiko holding headphones" width="941" height="1672" loading="lazy" />
      </div>
    </section>

    <section class="diary-section friend-page">
      <div class="shell friend-page__card">
        <img src="/assets/friends/mochiko-jannik-pose-2.webp" alt="Mochiko and Jannik holding game controllers" width="788" height="1400" loading="lazy" />
        <div><p class="entry-number">player two</p><h2>me & Jannik</h2><p>We’re friends and we play or stream together pretty often. He speaks German, I stream in English, so it gets slightly confusing.</p><p class="handwritten">and no, don’t ship us.</p><a class="button button--paper" href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">Jannik’s website <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
