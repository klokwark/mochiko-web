---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { favoriteGames, favoriteMusic } from "../data/site";

const outfits = [
  { file: "outfit-1.webp", name: "soft plaid", note: "the sleeves are the important part" },
  { file: "outfit-2.webp", name: "all black", note: "for serious button pressing" },
  { file: "outfit-3.webp", name: "lilac day", note: "matching the website by accident" },
  { file: "outfit-4.webp", name: "game mode", note: "the controller does not improve my aim" },
  { file: "outfit-5.webp", name: "tiny bows", note: "there was room for one more bow" },
  { file: "outfit-6.webp", name: "classic", note: "black, white, and ready to get distracted" },
];
---

<BaseLayout title="About Mochiko | VTuber" description="A little bit about Mochiko and the things she likes.">
  <SiteHeader />
  <main>
    <section class="about-diary-hero">
      <span class="about-diary-hero__star" aria-hidden="true">✦</span>
      <span class="about-diary-hero__heart" aria-hidden="true">♡</span>
      <div class="shell about-diary-hero__grid">
        <div class="about-diary-hero__copy">
          <p class="section-kicker">about me</p>
          <h1>my name is<br /><em>Mochiko!</em></h1>
          <p class="about-pronounce"><span>name_audio.txt</span> ˈmɔtʃiːˌkoː</p>
          <p>i never know what to put here, so i made a list.</p>
          <div class="about-diary-hero__facts">
            <span>cute games</span><span>pretty outfits</span><span>tiny collections</span><span>changing my mind</span>
          </div>
          <a class="button button--pink mt-7" href="#favorites">the important stuff <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
        </div>
        <div class="about-diary-hero__art">
          <div class="about-diary-hero__frame" aria-hidden="true"></div>
          <img src="/assets/red-dress-umbressa.webp" alt="Mochiko in a red dress holding an umbrella" width="1086" height="1448" fetchpriority="high" />
          <span class="about-diary-hero__note">i picked the outfit first ♡</span>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad outfit-closet" id="closet">
      <div class="shell">
        <div class="soft-heading">
          <div>
            <p class="section-kicker">closet.exe</p>
            <h2 class="section-title mt-4">pick an outfit!</h2>
          </div>
          <p class="outfit-closet__hint"><i class="ph ph-cursor-click" aria-hidden="true"></i> click the tiny me</p>
        </div>

        <div class="outfit-picker mt-10" data-outfit-picker>
          <div class="outfit-stage">
            <div class="outfit-stage__screen">
              {outfits.map((outfit, index) => (
                <img
                  class:list={["outfit-stage__image", { "is-active": index === 0 }]}
                  src={`/assets/outfits/${outfit.file}`}
                  alt={`Mochiko wearing the ${outfit.name} outfit`}
                  width="941"
                  height="1672"
                  loading={index === 0 ? "eager" : "lazy"}
                  data-outfit-image={index}
                />
              ))}
              <span class="outfit-stage__counter" data-outfit-counter>01 / 06</span>
            </div>
            <div class="outfit-stage__caption">
              <span>selected look</span>
              <strong data-outfit-name>{outfits[0].name}</strong>
              <p data-outfit-note>{outfits[0].note}</p>
            </div>
          </div>

          <div class="outfit-rack" role="tablist" aria-label="Choose Mochiko’s outfit">
            {outfits.map((outfit, index) => (
              <button
                class:list={["outfit-thumb", { "is-active": index === 0 }]}
                type="button"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                data-outfit-button={index}
                data-name={outfit.name}
                data-note={outfit.note}
              >
                <img src={`/assets/outfits/${outfit.file}`} alt="" width="941" height="1672" loading="lazy" />
                <span>0{index + 1}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad desktop-files">
      <div class="shell">
        <p class="section-kicker">important files</p>
        <h2 class="section-title mt-4">stuff my computer knows</h2>
        <div class="desktop-files__grid mt-9">
          <article class="desktop-file">
            <span><i class="ph-fill ph-folder-simple" aria-hidden="true"></i> inventory.log</span>
            <p>one quest item, twelve flowers, and a rock i might need later.</p>
          </article>
          <article class="desktop-file desktop-file--lilac">
            <span><i class="ph-fill ph-file-text" aria-hidden="true"></i> controls.txt</span>
            <p>i know the jump button. the rest is between me and the settings menu.</p>
          </article>
          <article class="desktop-file desktop-file--pink">
            <span><i class="ph-fill ph-floppy-disk" aria-hidden="true"></i> save_final_FINAL</span>
            <p>if i made the character pretty, the game is basically going well.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section-pad friend-about">
      <div class="shell friend-about__grid">
        <div class="friend-about__copy">
          <p class="section-kicker">my teammate</p>
          <h2 class="section-title mt-4">yes, that’s<br /><em>Jannik.</em></h2>
          <p class="body-lede mt-6">we’re friends and we play games together a lot. don’t ship us, please.</p>
          <a class="text-link mt-7" href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">go see his page <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
        <div class="friend-about__art">
          <span aria-hidden="true">2P</span>
          <img src="/assets/friends/mochiko-jannik-pose-2.webp" alt="Mochiko and Jannik holding game controllers" width="788" height="1400" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section-pad about-scrapbook" id="favorites">
      <div class="shell">
        <div class="about-scrapbook__heading">
          <p class="section-kicker">favorite games</p>
          <h2 class="section-title mt-4">my game ranking</h2>
          <p>yes, there are two #2s. no, i’m not fixing it.</p>
        </div>

        <div class="game-ranking mt-10">
          {favoriteGames.map((game) => (
            <a class="game-rank-card" href={game.href} target="_blank" rel="noreferrer">
              <div class="game-rank-card__cover">
                <img src={game.image} alt={`${game.title} cover`} width="600" height="800" loading="lazy" />
                <span>#{game.rank}</span>
              </div>
              <div class="game-rank-card__copy">
                <h3>{game.title}</h3>
                {game.note && <p>{game.note}</p>}
              </div>
            </a>
          ))}
        </div>

        <section class="music-detail">
          <div class="music-detail__heading">
            <p class="section-kicker">music</p>
            <h2 class="section-title mt-4">on repeat</h2>
            <p>this has been stuck in my head!!</p>
          </div>
          <a class="music-detail__artist" href={favoriteMusic.artistHref} target="_blank" rel="noreferrer">
            <img src={favoriteMusic.artistImage} alt={favoriteMusic.artist} width="1080" height="1080" loading="lazy" />
            <span>favorite artist rn</span>
            <h3>{favoriteMusic.artist}</h3>
          </a>
          <a class="music-detail__song" href={favoriteMusic.songHref} target="_blank" rel="noreferrer">
            <img src={favoriteMusic.songImage} alt={`${favoriteMusic.song} cover`} width="1000" height="1000" loading="lazy" />
            <div><span>favorite song</span><h3>{favoriteMusic.song}</h3><p>{favoriteMusic.songDetail}</p></div>
            <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
          <img class="music-detail__mochiko" src="/assets/gaming-3.webp" alt="Mochiko in a gaming outfit" width="1086" height="1448" loading="lazy" />
        </section>

        <div class="about-end-note">
          <span aria-hidden="true">୨୧</span>
          <p>that’s enough about me!! go look at the videos now ♡</p>
          <a class="button button--pink" href="/content">okay show me <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const setupOutfitPicker = () => {
    const picker = document.querySelector<HTMLElement>("[data-outfit-picker]");
    if (!picker || picker.dataset.ready === "true") return;
    picker.dataset.ready = "true";

    picker.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-outfit-button]");
      if (!button) return;
      const selected = button.dataset.outfitButton;

      picker.querySelectorAll<HTMLElement>("[data-outfit-image]").forEach((image) => {
        image.classList.toggle("is-active", image.dataset.outfitImage === selected);
      });
      picker.querySelectorAll<HTMLButtonElement>("[data-outfit-button]").forEach((item) => {
        const active = item === button;
        item.classList.toggle("is-active", active);
        item.setAttribute("aria-selected", String(active));
      });

      const name = picker.querySelector<HTMLElement>("[data-outfit-name]");
      const note = picker.querySelector<HTMLElement>("[data-outfit-note]");
      const counter = picker.querySelector<HTMLElement>("[data-outfit-counter]");
      if (name) name.textContent = button.dataset.name ?? "";
      if (note) note.textContent = button.dataset.note ?? "";
      if (counter) counter.textContent = `0${Number(selected) + 1} / 06`;
    });
  };

  setupOutfitPicker();
  document.addEventListener("astro:page-load", setupOutfitPicker);
</script>
