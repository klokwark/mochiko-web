---
import BaseLayout from "../layouts/BaseLayout.astro";

const navigation = [
  { label: "About", href: "#about" },
  { label: "Content", href: "#content" },
  { label: "Schedule", href: "#schedule" },
  { label: "Credits", href: "#credits" },
];

const contentCards = [
  {
    number: "01",
    title: "Singing",
    copy: "Soft songs, loud feelings, and the occasional tiny concert.",
    image: "/assets/content-singing.webp",
    alt: "Mochiko singing on stage",
    rotate: "-rotate-1",
    icon: "ph-microphone-stage",
  },
  {
    number: "02",
    title: "Gaming",
    copy: "Cozy adventures, chaotic choices, and very serious button pressing.",
    image: "/assets/content-gaming.webp",
    alt: "Mochiko playing a video game",
    rotate: "rotate-1",
    icon: "ph-game-controller",
  },
  {
    number: "03",
    title: "Just chatting",
    copy: "A comfy place to laugh, talk, and spend a little time together.",
    image: "/assets/content-cute.webp",
    alt: "Mochiko posing with a heart",
    rotate: "-rotate-1",
    icon: "ph-chat-circle-dots",
  },
];

const socials = [
  {
    label: "Twitch",
    handle: "mochikotv",
    href: "https://www.twitch.tv/mochikotv",
    icon: "ph-twitch-logo",
  },
  {
    label: "YouTube",
    handle: "@mochikotv",
    href: "https://www.youtube.com/@mochikotv",
    icon: "ph-youtube-logo",
  },
];

const year = new Date().getFullYear();
---

<BaseLayout>
  <header class="fixed inset-x-0 top-0 z-50 border-b-2 border-ink/10 bg-cream/90 backdrop-blur-xl">
    <div class="shell flex h-18 items-center justify-between gap-5 sm:h-20">
      <a href="#top" class="focus-ring shrink-0" aria-label="Mochiko home">
        <img src="/assets/logo.webp" alt="Mochiko" class="h-8 w-auto sm:h-10" width="360" height="98" />
      </a>

      <nav class="hidden items-center gap-8 text-xs font-black tracking-[0.16em] uppercase lg:flex" aria-label="Main navigation">
        {navigation.map((item) => (
          <a class="nav-link focus-ring" href={item.href}>{item.label}</a>
        ))}
      </nav>

      <div class="flex items-center gap-2">
        <a class="button button--dark hidden sm:inline-flex" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">
          <i class="ph-fill ph-circle" aria-hidden="true"></i>
          Watch live
        </a>

        <details class="mobile-menu relative lg:hidden">
          <summary class="focus-ring grid size-11 cursor-pointer list-none place-items-center rounded-full border-2 border-ink bg-pink text-xl shadow-hard" aria-label="Open navigation">
            <i class="ph ph-list" aria-hidden="true"></i>
          </summary>
          <nav class="absolute right-0 mt-3 w-56 border-2 border-ink bg-cream p-3 shadow-hard-lg" aria-label="Mobile navigation">
            {navigation.map((item) => (
              <a class="flex items-center justify-between border-b border-ink/15 px-3 py-3 text-sm font-black uppercase last:border-0" href={item.href}>
                {item.label}<i class="ph ph-arrow-down-right" aria-hidden="true"></i>
              </a>
            ))}
          </nav>
        </details>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="relative isolate flex min-h-[100svh] items-end overflow-hidden border-b-2 border-ink pt-24 lg:items-center lg:pt-20">
      <div class="hero-grid absolute inset-0 -z-20"></div>
      <div class="absolute inset-x-0 top-20 -z-10 h-40 bg-linear-to-b from-white/80 to-transparent"></div>
      <div class="absolute top-30 -right-24 -z-10 size-72 rounded-full bg-pink opacity-35 blur-3xl sm:size-96 lg:top-24 lg:right-0"></div>
      <div class="absolute bottom-0 left-0 -z-10 h-1/3 w-full bg-pink/15"></div>

      <div class="shell grid min-w-0 items-end gap-2 pt-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(26rem,1.1fr)] lg:items-center lg:gap-12 lg:pt-10">
        <div class="relative z-20 min-w-0 pb-3 sm:pb-8 lg:py-20">
          <p class="eyebrow mb-5">
            <span class="size-2 rounded-full bg-pink"></span>
            VTuber · EN / DE / RU
          </p>
          <h1 class="max-w-4xl text-[clamp(3.4rem,14vw,8.5rem)] leading-[0.82] font-black tracking-[-0.075em] uppercase">
            Cute,<br />cozy &<br /><span class="text-stroke">chaotic.</span>
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed font-semibold text-ink/70 sm:text-lg">
            Hi, I’m Mochiko, a child-like catgirl VTuber here to play, sing, laugh, and make the internet feel a little softer.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="button button--pink" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">
              <i class="ph-fill ph-play" aria-hidden="true"></i>
              Watch me live
            </a>
            <a class="button button--light" href="#about">
              Meet Mochiko
              <i class="ph ph-arrow-down" aria-hidden="true"></i>
            </a>
          </div>
        </div>

        <div class="relative z-10 mx-auto flex min-h-[44svh] w-full max-w-2xl items-end justify-center self-end lg:min-h-[calc(100svh-5rem)]">
          <span class="absolute top-6 right-3 rotate-8 text-5xl text-pink sm:top-10 sm:right-10 sm:text-7xl" aria-hidden="true">♡</span>
          <span class="absolute bottom-24 left-1 -rotate-12 border-2 border-ink bg-white px-3 py-2 text-xs font-black tracking-widest uppercase shadow-hard sm:left-8" aria-hidden="true">nice to meet you!</span>
          <div class="absolute inset-x-[8%] bottom-0 -z-10 h-[76%] rounded-t-[50%] border-2 border-b-0 border-ink bg-white shadow-[10px_0_0_#ff79ae]"></div>
          <img
            src="/assets/model.webp"
            alt="Mochiko, a pink-haired catgirl VTuber"
            class="relative z-10 max-h-[52svh] w-auto max-w-full object-contain object-bottom drop-shadow-[0_18px_18px_rgba(31,29,31,0.18)] sm:max-h-[58svh] lg:max-h-[calc(100svh-6rem)]"
            width="1200"
            height="1600"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <div class="ticker border-b-2 border-ink bg-ink py-3 text-cream" aria-hidden="true">
      <div class="ticker__track text-sm font-black tracking-[0.15em] uppercase">
        <span>Let’s play</span><b>♡</b><span>Let’s sing</span><b>♡</b><span>Let’s be silly</span><b>♡</b><span>Let’s play</span><b>♡</b><span>Let’s sing</span><b>♡</b><span>Let’s be silly</span><b>♡</b>
      </div>
    </div>

    <section id="about" class="section-pad scroll-mt-20 border-b-2 border-ink bg-white">
      <div class="shell grid min-w-0 gap-12 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:items-center lg:gap-20">
        <div class="relative mx-auto w-full max-w-lg min-w-0 px-4 pt-3 sm:px-8">
          <div class="absolute inset-5 translate-x-3 translate-y-3 rotate-3 border-2 border-ink bg-pink sm:inset-8"></div>
          <div class="relative -rotate-2 overflow-hidden border-2 border-ink bg-cream shadow-hard-lg">
            <img src="/assets/about.webp" alt="Mochiko smiling" class="aspect-[4/5] h-full w-full object-cover object-top" width="900" height="1125" loading="lazy" />
          </div>
          <span class="absolute -right-1 -bottom-5 grid size-20 rotate-10 place-items-center rounded-full border-2 border-ink bg-white text-center text-[0.65rem] leading-tight font-black tracking-wider uppercase shadow-hard sm:right-1 sm:size-24">
            soft heart<br />silly brain
          </span>
        </div>

        <div class="min-w-0">
          <p class="section-kicker">A little about me</p>
          <h2 class="section-title mt-3">Hi, I’m<br /><span class="text-pink">Mochiko.</span></h2>
          <div class="mt-7 max-w-2xl space-y-5 text-base leading-relaxed font-semibold text-ink/72 sm:text-lg">
            <p>
              I’m a child-like catgirl VTuber who loves turning every stream into a cozy little hangout. You’ll usually find me gaming, singing, chatting, and getting excited about the tiniest things.
            </p>
            <p>
              I speak English, German, and Russian. No matter which language brings you here, I hope you leave with a smile.
            </p>
          </div>

          <dl class="mt-9 grid max-w-xl grid-cols-1 gap-3 sm:grid-cols-2">
            <div class="fact-card">
              <dt><i class="ph ph-cake" aria-hidden="true"></i> Birthday</dt>
              <dd>August 30th</dd>
            </div>
            <div class="fact-card">
              <dt><i class="ph ph-translate" aria-hidden="true"></i> Languages</dt>
              <dd>EN · DE · RU</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="content" class="section-pad scroll-mt-20 border-b-2 border-ink bg-cream">
      <div class="shell min-w-0">
        <div class="flex min-w-0 flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
          <div class="min-w-0">
            <p class="section-kicker">On the channel</p>
            <h2 class="section-title mt-3">Pick your<br /><span class="text-stroke">favorite mood.</span></h2>
          </div>
          <p class="max-w-xs text-sm leading-relaxed font-bold text-ink/60 sm:text-right">A rotating mix of comfort, chaos, and very important catgirl business.</p>
        </div>

        <div class="mt-12 grid gap-7 md:grid-cols-3">
          {contentCards.map((card) => (
            <article class:list={["content-card group min-w-0", card.rotate]}>
              <div class="relative overflow-hidden border-b-2 border-ink bg-pink/20">
                <span class="absolute top-3 left-3 z-10 grid size-10 place-items-center rounded-full border-2 border-ink bg-cream text-xs font-black shadow-hard-sm">{card.number}</span>
                <img src={card.image} alt={card.alt} class="aspect-[4/3] w-full object-cover object-top transition duration-500 group-hover:scale-105" width="800" height="600" loading="lazy" />
              </div>
              <div class="p-5 sm:p-6">
                <div class="flex items-start justify-between gap-4">
                  <h3 class="text-2xl font-black uppercase">{card.title}</h3>
                  <i class:list={["ph text-2xl text-pink", card.icon]} aria-hidden="true"></i>
                </div>
                <p class="mt-3 text-sm leading-relaxed font-semibold text-ink/65">{card.copy}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="schedule" class="section-pad scroll-mt-20 overflow-hidden border-b-2 border-ink bg-pink text-ink">
      <div class="shell relative min-w-0">
        <span class="absolute -top-20 -right-16 select-none text-[12rem] leading-none font-black text-white/22 sm:text-[18rem]" aria-hidden="true">♡</span>
        <div class="relative grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
          <div class="min-w-0">
            <p class="section-kicker">Next stream</p>
            <h2 class="mt-3 max-w-4xl text-[clamp(3.2rem,10vw,8rem)] leading-[0.84] font-black tracking-[-0.07em] uppercase">Come<br />hang out.</h2>
          </div>
          <div class="max-w-md border-2 border-ink bg-cream p-5 shadow-hard-lg sm:p-7">
            <div class="mb-5 flex items-center gap-3">
              <span class="relative flex size-3">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-pink opacity-70"></span>
                <span class="relative inline-flex size-3 rounded-full bg-pink"></span>
              </span>
              <p class="text-xs font-black tracking-[0.18em] uppercase">Schedule updates</p>
            </div>
            <p class="text-xl leading-snug font-black">New stream times are posted on Twitch.</p>
            <p class="mt-3 text-sm leading-relaxed font-semibold text-ink/60">Follow the channel so the next cozy little adventure finds you.</p>
            <a class="button button--dark mt-6 w-full" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">
              Open Twitch
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="credits" class="section-pad scroll-mt-20 border-b-2 border-ink bg-white">
      <div class="shell grid min-w-0 gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:items-center lg:gap-20">
        <div class="order-2 min-w-0 lg:order-1">
          <p class="section-kicker">Made with care</p>
          <h2 class="section-title mt-3">Creative<br /><span class="text-pink">credits.</span></h2>
          <p class="mt-6 max-w-xl text-base leading-relaxed font-semibold text-ink/65 sm:text-lg">The talented artist who helped bring my look to life.</p>
          <div class="mt-8 max-w-lg border-2 border-ink bg-cream p-5 shadow-hard sm:p-6">
            <div class="flex items-center gap-4">
              <span class="grid size-12 shrink-0 place-items-center rounded-full border-2 border-ink bg-pink text-2xl">
                <i class="ph ph-paint-brush" aria-hidden="true"></i>
              </span>
              <div class="min-w-0">
                <p class="text-[0.65rem] font-black tracking-[0.18em] text-ink/50 uppercase">Illustrator</p>
                <p class="mt-1 break-words text-2xl font-black">klokwark</p>
              </div>
            </div>
          </div>
        </div>

        <div class="relative order-1 mx-auto w-full max-w-lg lg:order-2">
          <div class="absolute inset-4 translate-x-3 translate-y-3 -rotate-3 border-2 border-ink bg-ink"></div>
          <div class="relative rotate-2 overflow-hidden border-2 border-ink bg-pink shadow-hard-lg">
            <img src="/assets/credits.webp" alt="Mochiko character artwork" class="aspect-[4/5] w-full object-cover object-top" width="900" height="1125" loading="lazy" />
          </div>
        </div>
      </div>
    </section>

    <section id="connect" class="section-pad bg-ink text-cream">
      <div class="shell min-w-0">
        <div class="grid min-w-0 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,0.8fr)] lg:items-end">
          <div class="min-w-0">
            <p class="section-kicker text-pink">Find me online</p>
            <h2 class="mt-3 max-w-4xl text-[clamp(3.2rem,10vw,8rem)] leading-[0.84] font-black tracking-[-0.07em] uppercase">Let’s stay<br /><span class="text-pink">connected.</span></h2>
          </div>
          <p class="max-w-md text-base leading-relaxed font-semibold text-cream/65 lg:pb-2">Streams, videos, and tiny moments from my day live here.</p>
        </div>

        <div class="mt-10 grid gap-3 sm:grid-cols-2">
          {socials.map((social) => (
            <a class="social-link focus-ring group" href={social.href} target="_blank" rel="noreferrer">
              <span class="flex min-w-0 items-center gap-4">
                <span class="grid size-12 shrink-0 place-items-center rounded-full border-2 border-cream/30 bg-cream/5 text-2xl text-pink transition group-hover:border-ink group-hover:bg-pink group-hover:text-ink">
                  <i class:list={["ph", social.icon]} aria-hidden="true"></i>
                </span>
                <span class="min-w-0">
                  <span class="block text-[0.65rem] font-black tracking-[0.18em] text-cream/45 uppercase">{social.label}</span>
                  <span class="mt-1 block truncate text-xl font-black">{social.handle}</span>
                </span>
              </span>
              <i class="ph ph-arrow-up-right text-2xl text-pink transition group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-cream/15 bg-ink py-7 text-cream">
    <div class="shell flex flex-col gap-5 text-xs font-bold tracking-wider uppercase sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <img src="/assets/bunny-mark.webp" alt="" class="h-9 w-auto invert" width="40" height="40" loading="lazy" />
        <p>© {year} Mochiko</p>
      </div>
      <div class="flex flex-wrap gap-x-5 gap-y-2 text-cream/55">
        <a class="hover:text-pink" href="#about">About</a>
        <a class="hover:text-pink" href="#content">Content</a>
        <a class="hover:text-pink" href="#credits">Credits</a>
      </div>
    </div>
  </footer>
</BaseLayout>
