---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { contentCards, socials } from "../data/site";
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="soft-hero">
      <div class="soft-dots" aria-hidden="true"></div>
      <span class="doodle doodle--heart" aria-hidden="true">♡</span>
      <span class="doodle doodle--bow" aria-hidden="true">୨୧</span>
      <div class="shell soft-hero__grid">
        <div class="soft-hero__copy">
          <p class="bubble-label">hiii!! welcome to my lil corner ♡</p>
          <h1 class="soft-hero__title">cute, cozy &<br /><em>a tiny bit chaotic!</em></h1>
          <p class="soft-hero__lede">i’m Mochiko! i play games, yap about everything, laugh way too much, and try to make the internet feel a little softer.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="button button--pink" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
              <i class="ph-fill ph-heart" aria-hidden="true"></i><span data-live-label>come watch me!</span>
            </a>
            <a class="button button--white" href="/content">my videos <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
          <div class="mini-note"><span>currently obsessed with</span><strong>cozy games & cute stuff</strong></div>
        </div>

        <div class="soft-hero__art">
          <div class="hero-cloud" aria-hidden="true"></div>
          <span class="sticker sticker--top" aria-hidden="true">so happy<br />you’re here!</span>
          <span class="sticker sticker--bottom" aria-hidden="true">♡</span>
          <img src="/assets/model.webp" alt="Mochiko" width="1200" height="1600" fetchpriority="high" />
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad bg-white">
      <div class="shell grid min-w-0 gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:items-center lg:gap-18">
        <div class="soft-photo">
          <div class="soft-photo__dots" aria-hidden="true"></div>
          <img src="/assets/about.webp" alt="Mochiko smiling" width="900" height="1125" loading="lazy" />
          <span class="soft-photo__tag">just me being me ♡</span>
        </div>
        <div class="min-w-0">
          <p class="section-kicker">a lil about me</p>
          <h2 class="section-title mt-4">i’m Mochiko!!<br /><em>nice to meet u ♡</em></h2>
          <p class="body-lede mt-6">my streams are basically a big cozy hangout. sometimes i’m locked in, sometimes i forget what i was doing, and honestly both are fun.</p>
          <a class="button button--ink mt-7" href="/about">more about me <i class="ph ph-heart" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="banner-wrap">
      <div class="shell">
        <div class="cute-banner">
          <div class="cute-banner__label"><span>my whole little world</span><b>♡ ୨୧ ♡</b></div>
          <img src="/assets/mochikobanner.png" alt="Mochiko surrounded by ribbons, cherry blossoms, lace, and bunny motifs" width="1672" height="941" loading="lazy" />
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="shell">
        <div class="soft-heading">
          <div>
            <p class="section-kicker">stuff i do</p>
            <h2 class="section-title mt-4">pick a mood<br /><em>and stay awhile!</em></h2>
          </div>
          <a class="text-link" href="/content">see the newest stuff <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {contentCards.map((card) => (
            <a class="squishy-card" href="/content">
              <div class="squishy-card__image"><img src={card.image} alt={card.alt} width="800" height="600" loading="lazy" /></div>
              <div class="squishy-card__body">
                <span class="squishy-card__icon"><i class:list={["ph", card.icon]} aria-hidden="true"></i></span>
                <div><h3>{card.title}</h3><p>{card.copy}</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad connect-candy">
      <div class="shell">
        <div class="text-center">
          <p class="section-kicker justify-center">find me everywhere</p>
          <h2 class="section-title mx-auto mt-4">let’s be<br /><em>internet besties!</em></h2>
        </div>
        <div class="mx-auto mt-9 grid max-w-4xl gap-3 sm:grid-cols-2">
          {socials.map((social) => (
            <a class="social-candy" href={social.href} target="_blank" rel="noreferrer">
              <span><i class:list={["ph", social.icon]} aria-hidden="true"></i></span>
              <div><strong>{social.label}</strong><small>{social.handle}</small></div>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
