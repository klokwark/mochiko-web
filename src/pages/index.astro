---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { contentCards, socials } from "../data/site";
---

<BaseLayout>
  <SiteHeader />

  <main>
    <section class="hero">
      <div class="shell hero__grid">
        <div class="hero__copy">
          <p class="eyebrow reveal-line"><span>VTuber</span><b>EN · DE · RU</b></p>
          <h1 class="hero__title mask-reveal">
            Hi, I’m<br /><em>Mochiko.</em>
          </h1>
          <p class="hero__lede">Your child-like catgirl host for games, songs, soft moments, and a very reasonable amount of chaos.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a class="button button--pink" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">
              Watch me live <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
            <a class="button button--paper" href="/about">
              Get to know me <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
          <div class="hero__note">
            <span class="hero__note-number">08.30</span>
            <span>Birthday</span>
          </div>
        </div>

        <div class="hero__art" aria-label="Mochiko character artwork">
          <div class="hero__art-rail" aria-hidden="true">
            <span>MOCHIKO</span><span>MOCHIKO</span>
          </div>
          <div class="hero__art-stage">
            <span class="hero__stamp" aria-hidden="true">nice to<br />meet you</span>
            <img src="/assets/model.webp" alt="Mochiko, a pink-haired catgirl VTuber" width="1200" height="1600" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad bg-white">
      <div class="shell grid min-w-0 gap-12 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:items-center lg:gap-20">
        <div class="editorial-photo photo-cut">
          <img src="/assets/about.webp" alt="Mochiko smiling" width="900" height="1125" loading="lazy" />
          <span class="photo-label">soft heart / silly brain</span>
        </div>
        <div class="min-w-0">
          <p class="section-kicker">A little about me</p>
          <h2 class="section-title mt-5">Tiny catgirl.<br /><em>Big feelings.</em></h2>
          <p class="body-lede mt-7">I’m Mochiko. I love turning every stream into a cozy little hangout where we can game, sing, chat, and get excited about the tiniest things together.</p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a class="text-link" href="/about">Read my story <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </section>

    <section class="banner-section" aria-labelledby="banner-title">
      <div class="shell">
        <div class="banner-frame">
          <div class="banner-frame__top">
            <span>Welcome to my world</span>
            <span aria-hidden="true">✦ 08.30 ✦</span>
          </div>
          <img src="/assets/mochikobanner.png" alt="Mochiko surrounded by black ribbons, cherry blossoms, lace, and bunny motifs" width="1672" height="941" loading="lazy" />
          <div class="banner-frame__bottom">
            <h2 id="banner-title">A little gothic, a lot cozy.</h2>
            <a href="/about" aria-label="More about Mochiko"><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="shell min-w-0">
        <div class="section-heading">
          <div class="min-w-0">
            <p class="section-kicker">Choose your mood</p>
            <h2 class="section-title mt-5">On the<br /><em>channel.</em></h2>
          </div>
          <a class="text-link" href="/content">See all content <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {contentCards.map((card) => (
            <a class="channel-card group" href="/content">
              <div class="channel-card__image">
                <img src={card.image} alt={card.alt} width="800" height="600" loading="lazy" />
                <span>{card.number}</span>
              </div>
              <div class="channel-card__body">
                <h3>{card.title}</h3>
                <i class:list={["ph", card.icon]} aria-hidden="true"></i>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="connect-strip">
      <div class="shell grid min-w-0 gap-8 py-14 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
        <div class="min-w-0">
          <p class="section-kicker text-pink">Stay close</p>
          <h2 class="font-display mt-4 text-[clamp(2.6rem,7vw,5.8rem)] leading-[0.9] font-bold tracking-[-0.055em]">Find me online.</h2>
        </div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          {socials.map((social) => (
            <a class="social-pill" href={social.href} target="_blank" rel="noreferrer">
              <i class:list={["ph", social.icon]} aria-hidden="true"></i>
              <span>{social.label}</span>
              <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
