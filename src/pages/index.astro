---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { favoriteGames, favoriteMusic, playlist, socials } from "../data/site";

const [twitch, ...channels] = socials;
const channelTones = ["cream", "lilac", "ink", "butter"];
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="home-hero">
      <div class="shell home-hero__grid">
        <div class="home-hero__copy">
          <p class="sticker-label sticker-label--tilt">moin!!</p>
          <h1 class="title-xl home-hero__title">hii, ich bin<br /><em>Mochiko!</em></h1>
          <p class="lede">ich bin vtuberin aus norddeutschland! auf twitch streame ich games, meistens minecraft und genshin, und die besten momente lad ich auf youtube hoch.</p>
          <div class="button-row">
            <a class="button button--pink" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer">
              <i class="ph-fill ph-twitch-logo" aria-hidden="true"></i><span data-hero-live-label>auf twitch gucken</span>
            </a>
            <a class="button button--cream" href="/content">videos <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
          <nav class="home-hero__socials" aria-label="Mochiko im Netz">
            <span>auch auf</span>
            {socials.map((social) => (
              <a href={social.href} target="_blank" rel="noreferrer" aria-label={social.label} title={social.label}>
                <i class:list={["ph-fill", social.icon]} aria-hidden="true"></i>
              </a>
            ))}
          </nav>
        </div>

        <div class="figure-box-wrap">
          <div class="figure-box">
            <span class="figure-box__hang" aria-hidden="true"></span>
            <p class="figure-box__top" aria-hidden="true"><span>sammelfigur</span><span>serie 01</span></p>
            <div class="figure-box__window">
              <img class="figure-box__me" src="/assets/model.webp" alt="Mochiko umarmt ihren Plüschhasen" width="960" height="1280" fetchpriority="high" />
            </div>
            <div class="figure-box__plate">
              <img src="/assets/mochiko-wordmark.webp" alt="" width="960" height="439" />
                          </div>
            <span class="figure-box__seal" aria-hidden="true">neu!!</span>
          </div>
        </div>
      </div>
    </section>

    <section class="home-live scallop-top" data-home-live data-state="unset" aria-live="polite">
      <div class="shell home-live__inner">
        <img class="home-live__face die-cut" src="/assets/emotions/wondering.webp" alt="" width="1254" height="1254" data-home-live-face />
        <div class="home-live__copy">
          <span class="home-live__badge"><i class="ph-fill ph-circle" aria-hidden="true"></i><span data-home-live-status>twitch</span></span>
          <strong data-home-live-title>bin ich live?</strong>
          <span data-home-live-detail>klick im datenschutz-fenster auf „okay, laden“, dann guck ich für dich nach</span>
        </div>
        <div class="home-live__actions">
          <a class="button button--ink" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer"><span data-home-live-cta>zu Twitch</span> <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <button class="home-live__privacy" type="button" data-open-privacy data-home-live-privacy hidden>datenschutz-einstellung ändern</button>
        </div>
      </div>
    </section>

    <Marquee />

    <section class="section-pad home-about">
      <div class="shell home-about__grid">
        <figure class="snapshot">
          <span class="tape tape--left" aria-hidden="true"></span>
          <span class="tape tape--right" aria-hidden="true"></span>
          <div class="snapshot__photo">
            <img src="/assets/about.webp" alt="Mochiko sitzt lachend mit ihrem Plüschhasen auf dem Boden" width="900" height="1200" loading="lazy" />
          </div>
          <figcaption>ich + hase</figcaption>
        </figure>

        <div class="home-about__copy">
          <p class="kicker">über mich</p>
          <h2 class="title-lg">freut<br /><em>mich!</em></h2>
          <p class="lede">die meisten nennen mich mochi. meinen pc hab ich selbst zusammengeschraubt, auf meinem schreibtisch sitzen lauter plüschtiere und ich liebe füchse einfach über alles.</p>
          <ul class="chip-row" aria-label="Ein paar Dinge, die Mochiko mag">
            <li>füchse</li>
            <li>alles in blau</li>
            <li>aufbauspiele</li>
            <li>horrorfilme</li>
          </ul>
          <a class="button button--cream" href="/about">mehr über mich <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="section-pad home-faves scallop-top" id="favorites">
      <img class="home-faves__me" src="/assets/gaming-3.webp" alt="" width="1086" height="1448" loading="lazy" />
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">lieblingszeug</p>
            <h2 class="title-lg">worauf ich <em>grad</em> steh</h2>
          </div>
          <a class="text-link" href="/about#favorites">ganze liste <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="home-faves__grid">
          <div class="game-fan">
            <p class="game-fan__label">meine top 3</p>
            <div class="game-fan__cards">
              {favoriteGames.slice(0, 3).map((game, index) => (
                <a class="game-fan__card" href={game.href} target="_blank" rel="noreferrer" style={`--i:${index}`}>
                  <img src={game.image} alt={`Cover von ${game.title}`} width="600" height="800" loading="lazy" />
                  <span>#{game.rank}</span>
                </a>
              ))}
            </div>
            <ul class="game-fan__names">
              {favoriteGames.slice(0, 3).map((game) => <li data-rank={game.rank}>{game.title}</li>)}
            </ul>
          </div>

          <div class="record-card">
            <div class="record-card__deck" aria-hidden="true">
              <span class="record-card__disc"><img src={favoriteMusic.artistImage} alt="" width="800" height="800" loading="lazy" /></span>
              <img class="record-card__sleeve" src={favoriteMusic.songImage} alt="" width="800" height="800" loading="lazy" />
            </div>
            <div class="record-card__copy">
              <span class="record-card__tag">in dauerschleife</span>
              <h3>{favoriteMusic.song}</h3>
              <p>{favoriteMusic.songDetail}</p>
              <div class="record-card__links">
                <a href={favoriteMusic.songHref} target="_blank" rel="noreferrer">anhören <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
                <a href={playlist.href} target="_blank" rel="noreferrer"><i class="ph-fill ph-spotify-logo" aria-hidden="true"></i> {playlist.label}</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad home-channels">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">socials</p>
            <h2 class="title-lg">hier <em>findest du mich</em></h2>
          </div>
          <a class="text-link" href="/content">neueste videos <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="channels">
          <article class="channel-main">
            <span class="channel-main__icon"><i class:list={["ph-fill", twitch.icon]} aria-hidden="true"></i></span>
            <p class="channel-main__handle">twitch.tv/{twitch.handle}</p>
            <h3>streams</h3>
            <p>{twitch.blurb}</p>
            <div class="button-row">
              <a class="button button--ink" href={twitch.href} target="_blank" rel="noreferrer">live zuschauen <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
              <a class="button button--cream" href="/schedule">streamplan <i class="ph ph-calendar-heart" aria-hidden="true"></i></a>
            </div>
          </article>

          <div class="channel-stack">
            <img class="channel-stack__me die-cut" src="/assets/blue-phone.webp" alt="" width="1086" height="1448" loading="lazy" />
            {channels.map((channel, index) => (
              <a class:list={["channel-card", `channel-card--${channelTones[index]}`]} href={channel.href} target="_blank" rel="noreferrer">
                <span class="channel-card__top">
                  <i class:list={["ph-fill", channel.icon]} aria-hidden="true"></i>
                  <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </span>
                <strong>{channel.label}</strong>
                <small>{channel.blurb}</small>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { formatStreamTime, getTwitch, onPrivacyChoice, upcomingStreams } from "../scripts/live";

  type LiveState = "unset" | "loading" | "live" | "offline" | "declined" | "error";

  const faces: Record<LiveState, string> = {
    unset: "wondering",
    loading: "loading",
    live: "happy",
    offline: "sad",
    declined: "wondering",
    error: "surprised",
  };

  const render = (root: HTMLElement, state: LiveState, text: { status: string; title: string; detail: string; cta?: string }) => {
    root.dataset.state = state;
    const set = (selector: string, value: string) => {
      const element = root.querySelector(selector);
      if (element) element.textContent = value;
    };
    set("[data-home-live-status]", text.status);
    set("[data-home-live-title]", text.title);
    set("[data-home-live-detail]", text.detail);
    set("[data-home-live-cta]", text.cta ?? "zu Twitch");
    const face = root.querySelector<HTMLImageElement>("[data-home-live-face]");
    if (face) face.src = `/assets/emotions/${faces[state]}.webp`;
    const privacy = root.querySelector<HTMLElement>("[data-home-live-privacy]");
    if (privacy) privacy.hidden = state !== "declined";
    const heroLabel = document.querySelector("[data-hero-live-label]");
    if (heroLabel) heroLabel.textContent = state === "live" ? "bin grad live!" : "auf twitch gucken";
  };

  onPrivacyChoice((choice) => {
    const root = document.querySelector<HTMLElement>("[data-home-live]");
    if (!root) return;

    if (choice === "unset") {
      render(root, "unset", { status: "twitch", title: "bin ich live?", detail: "klick im datenschutz-fenster auf „okay, laden“, dann guck ich für dich nach" });
      return;
    }
    if (choice === "declined") {
      render(root, "declined", { status: "twitch ist aus", title: "kann grad nicht nachgucken", detail: "du hast nein zu twitch gesagt, voll okay! der button geht trotzdem" });
      return;
    }

    if (root.dataset.state !== "live" && root.dataset.state !== "offline") {
      render(root, "loading", { status: "checke grad...", title: "eine sek!", detail: "ich guck mal nach..." });
    }

    getTwitch()
      .then((data) => {
        if (!data.live) throw new Error("Live status unknown");
        if (data.live.isLive) {
          const detail = [data.live.gameName, data.live.viewerCount ? `${data.live.viewerCount} zuschauer` : ""].filter(Boolean).join(" ·\u00a0");
          render(root, "live", { status: "live!", title: data.live.title || "bin live!", detail: detail || "komm vorbei", cta: "zuschauen" });
          return;
        }
        const next = upcomingStreams(data.schedule)[0];
        render(root, "offline", {
          status: "offline",
          title: "nicht live grad",
          detail: next
            ? `nächster stream: ${formatStreamTime(next.startTime)}${next.category ? ` ·\u00a0${next.category}` : ""}`
            : data.schedule ? "noch kein stream geplant, guck später nochmal rein" : "den streamplan gibt’s grad nur auf twitch",
        });
      })
      .catch(() => {
        render(root, "error", { status: "hmm", title: "twitch antwortet nicht", detail: "dann einfach direkt rüber zu twitch" });
      });
  });
</script>
