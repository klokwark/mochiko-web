---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { favoriteGames, favoriteMusic, socials } from "../data/site";

const noteBits = [
  { icon: "ph-film-slate", label: "movies", detail: "horror" },
  { icon: "ph-game-controller", label: "games", detail: "not horror" },
  { icon: "ph-paw-print", label: "animal", detail: "fox" },
  { icon: "ph-paint-brush", label: "colour", detail: "blue" },
];
---

<BaseLayout>
  <SiteHeader />
  <main class="home-notebook">
    <div class="scroll-notebook" data-scroll-notebook style="--notebook-pages: 5">
      <div class="scroll-notebook__sticky">
        <div class="scroll-notebook__stack">
          <article class="notebook-sheet notebook-sheet--intro" data-notebook-sheet>
            <span class="notebook-sheet__number">01</span>
    <section class="diary-hero">
      <div class="paper-grain" aria-hidden="true"></div>
      <div class="shell diary-hero__page">
        <div class="diary-hero__copy">
          <p class="diary-date">entry no. 01 <span>somewhere in northern germany</span></p>
          <h1>hi, i’m<br /><em>Mochi.</em></h1>
          <p class="diary-hero__intro">I’m much louder online than I am in person. I stream games in English, get distracted easily, and usually have three things open that I forgot about.</p>
          <div class="diary-hero__actions">
            <a class="button button--blue" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
              <i class="ph-fill ph-twitch-logo" aria-hidden="true"></i><span data-live-label>my twitch</span>
            </a>
            <a class="ink-link" href="/about">read my notes <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
          <p class="margin-note">usually called Mochi</p>
        </div>

        <div class="diary-hero__photo">
          <span class="tape tape--top" aria-hidden="true"></span>
          <span class="photo-label">MOCHIKO / MOCHI</span>
          <img src="/assets/model.webp" alt="Mochiko holding a bunny plush" width="960" height="1280" fetchpriority="high" />
          <span class="photo-scribble" aria-hidden="true">that’s me!</span>
        </div>

        <img class="diary-hero__mascot" src="/assets/diary-bunny.webp" alt="Mochiko's white bunny mascot" width="866" height="900" />
        <span class="binder-hole binder-hole--one" aria-hidden="true"></span>
        <span class="binder-hole binder-hole--two" aria-hidden="true"></span>
        <span class="binder-hole binder-hole--three" aria-hidden="true"></span>
      </div>
    </section>

    <section class="live-note" data-home-live>
      <div class="shell live-note__inner">
        <span class="live-note__pin" aria-hidden="true"></span>
        <div class="live-note__status"><i class="ph-fill ph-circle" aria-hidden="true"></i><span data-home-live-status>checking twitch</span></div>
        <div class="live-note__copy">
          <strong data-home-live-title>one second...</strong>
          <span data-home-live-detail>seeing if the light is on.</span>
        </div>
        <a href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-home-live-button>open twitch <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </section>

          </article>
          <article class="notebook-sheet notebook-sheet--about" data-notebook-sheet inert aria-hidden="true">
            <span class="notebook-sheet__number">02</span>

    <section class="diary-section diary-section--blue">
      <div class="shell entry-grid">
        <div class="entry-copy">
          <p class="entry-number">02 / about</p>
          <h2>what I actually<br /><em>wrote down</em></h2>
          <p>I like cute things, computers, horror movies and games that let me spend far too long in one menu. I collect plushies and anything else that looks good on a shelf.</p>
          <p>Pink ended up everywhere, but blue is still my favourite colour.</p>
          <a class="button button--paper" href="/about">more about me <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="note-board">
          <span class="tape tape--corner" aria-hidden="true"></span>
          <p class="note-board__title">quick notes</p>
          <div class="note-bits">
            {noteBits.map((bit) => (
              <div class="note-bit"><i class:list={["ph-fill", bit.icon]} aria-hidden="true"></i><span>{bit.label}</span><b>{bit.detail}</b></div>
            ))}
          </div>
          <p class="handwritten">I still don’t like horses.</p>
          <img class="note-board__stationery" src="/assets/diary-stationery.webp" alt="" width="900" height="900" loading="lazy" />
        </div>
      </div>
    </section>

            <img class="notebook-edge-sitter notebook-edge-sitter--about" src="/assets/headphones-sitting.webp" alt="Mochiko sitting on the edge of the notebook page" width="941" height="1672" loading="lazy" />
          </article>
          <article class="notebook-sheet notebook-sheet--favorites" data-notebook-sheet inert aria-hidden="true">
            <span class="notebook-sheet__number">03</span>

    <section class="diary-section paper-section" id="favorites">
      <div class="shell">
        <div class="entry-heading">
          <div><p class="entry-number">03 / current favourites</p><h2>things I keep<br /><em>going back to</em></h2></div>
          <a class="ink-link" href="/about#favorites">the full list <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="scrap-grid">
          <div class="game-scraps">
            {favoriteGames.slice(0, 3).map((game, index) => (
              <a class:list={["game-polaroid", `game-polaroid--${index + 1}`]} href={game.href} target="_blank" rel="noreferrer">
                <img src={game.image} alt={`${game.title} cover`} width="600" height="800" loading="lazy" />
                <span>#{game.rank} {game.title}</span>
              </a>
            ))}
          </div>
          <article class="music-note">
            <span class="tape tape--music" aria-hidden="true"></span>
            <p class="music-note__label">currently on repeat</p>
            <img src={favoriteMusic.songImage} alt={`${favoriteMusic.song} cover`} width="1000" height="1000" loading="lazy" />
            <div><h3>{favoriteMusic.song}</h3><p>{favoriteMusic.songDetail}</p><a href={favoriteMusic.songHref} target="_blank" rel="noreferrer">listen <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
            <p class="handwritten">favourite track right now</p>
          </article>
        </div>
      </div>
    </section>

          </article>
          <article class="notebook-sheet notebook-sheet--content" data-notebook-sheet inert aria-hidden="true">
            <span class="notebook-sheet__number">04</span>

    <section class="diary-section diary-section--pink">
      <div class="shell content-entry">
        <div class="content-entry__heading">
          <p class="entry-number">04 / uploads</p>
          <h2>streams live here.<br /><em>videos do too.</em></h2>
          <p>I stream on Twitch and put the other bits on YouTube. The content page keeps the newest ones together.</p>
          <a class="button button--blue" href="/content">open the content page <i class="ph ph-play" aria-hidden="true"></i></a>
        </div>
        <div class="content-entry__art">
          <span class="tape tape--top" aria-hidden="true"></span>
          <img src="/assets/gaming-1.webp" alt="Mochiko holding a game controller" width="1086" height="1448" loading="lazy" />
          <span>game controller included</span>
        </div>
      </div>
    </section>

            <img class="notebook-edge-sitter notebook-edge-sitter--content" src="/assets/cute-pose2.webp" alt="Mochiko sitting on the lower edge of the page with a bunny plush" width="1122" height="1402" loading="lazy" />
          </article>
          <article class="notebook-sheet notebook-sheet--links" data-notebook-sheet inert aria-hidden="true">
            <span class="notebook-sheet__number">05</span>

    <section class="diary-section paper-section">
      <div class="shell small-entry-grid">
        <article class="friend-footnote">
          <img src="/assets/friends/mochiko-jannik-pose-3.webp" alt="Mochiko and Jannik standing together" width="788" height="1400" loading="lazy" />
          <div><p class="entry-number">side note</p><h2>Jannik is usually player two.</h2><p>We’re friends and play together a lot. He has his own website too.</p><a class="ink-link" href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">visit Jannik <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
        </article>
        <aside class="link-page">
          <p class="entry-number">find me elsewhere</p>
          {socials.map((social) => (
            <a href={social.href} target="_blank" rel="noreferrer"><i class:list={["ph-fill", social.icon]} aria-hidden="true"></i><span><b>{social.label}</b><small>{social.handle}</small></span><i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          ))}
        </aside>
      </div>
    </section>

          </article>
        </div>
        <div class="notebook-progress" aria-hidden="true">
          <span data-notebook-progress>01 / 05</span>
          <i><b data-notebook-progress-bar></b></i>
          <small>scroll to turn the page</small>
        </div>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const updateHomeLive = () => {
    const homeLive = document.querySelector<HTMLElement>("[data-home-live]");
    if (!homeLive || homeLive.dataset.loaded === "true") return;
    homeLive.dataset.loaded = "true";
    const status = homeLive.querySelector<HTMLElement>("[data-home-live-status]");
    const title = homeLive.querySelector<HTMLElement>("[data-home-live-title]");
    const detail = homeLive.querySelector<HTMLElement>("[data-home-live-detail]");
    const button = homeLive.querySelector<HTMLElement>("[data-home-live-button]");
    fetch("/api/twitch").then((response) => response.json()).then((data) => {
      const live = data?.live?.isLive === true;
      homeLive.dataset.isLive = String(live);
      if (status) status.textContent = live ? "live now" : "offline";
      if (title) title.textContent = live ? (data.live.title || "the stream is on") : "not live right now";
      if (detail) detail.textContent = live ? (data.live.gameName || "come see what I picked") : "the channel and old streams are still here.";
      if (button) button.firstChild!.textContent = live ? "watch now " : "open twitch ";
    }).catch(() => {
      if (status) status.textContent = "twitch";
      if (title) title.textContent = "status unavailable";
      if (detail) detail.textContent = "the direct link still works.";
    });
  };

  const maybeUpdateHomeLive = () => {
    const homeLive = document.querySelector<HTMLElement>("[data-home-live]");
    if (!homeLive) return;
    if (document.documentElement.dataset.privacyChoice === "accepted") updateHomeLive();
    if (document.documentElement.dataset.privacyChoice === "declined") {
      const status = homeLive.querySelector<HTMLElement>("[data-home-live-status]");
      const title = homeLive.querySelector<HTMLElement>("[data-home-live-title]");
      const detail = homeLive.querySelector<HTMLElement>("[data-home-live-detail]");
      if (status) status.textContent = "not loaded";
      if (title) title.textContent = "twitch is switched off";
      if (detail) detail.textContent = "the direct channel link still works.";
    }
  };

  maybeUpdateHomeLive();
  window.addEventListener("mochiko:privacy-choice", maybeUpdateHomeLive);
  document.addEventListener("astro:page-load", maybeUpdateHomeLive);

  const setupScrollNotebook = () => {
    const notebook = document.querySelector<HTMLElement>("[data-scroll-notebook]");
    if (!notebook || notebook.dataset.ready === "true") return;
    notebook.dataset.ready = "true";
    const sheets = Array.from(notebook.querySelectorAll<HTMLElement>("[data-notebook-sheet]"));
    const progressLabel = notebook.querySelector<HTMLElement>("[data-notebook-progress]");
    const progressBar = notebook.querySelector<HTMLElement>("[data-notebook-progress-bar]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    const setSheet = (sheet: HTMLElement, index: number, current: number, turn: number) => {
      const isCurrent = index === current;
      sheet.style.setProperty("--page-turn", String(turn));
      sheet.style.zIndex = String(sheets.length - index);
      sheet.classList.toggle("is-current", isCurrent);
      sheet.classList.toggle("is-turned", index < current);
      sheet.toggleAttribute("inert", !isCurrent);
      sheet.setAttribute("aria-hidden", String(!isCurrent));
    };

    const update = () => {
      if (reduced.matches || window.innerWidth < 900) {
        sheets.forEach((sheet) => {
          sheet.style.removeProperty("--page-turn");
          sheet.style.removeProperty("z-index");
          sheet.classList.remove("is-turned");
          sheet.classList.add("is-current");
          sheet.removeAttribute("inert");
          sheet.setAttribute("aria-hidden", "false");
        });
        return;
      }

      const rect = notebook.getBoundingClientRect();
      const travel = Math.max(1, notebook.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / travel));
      const exactPage = progress * (sheets.length - 1);
      const current = Math.min(sheets.length - 1, Math.floor(exactPage + .5));

      sheets.forEach((sheet, index) => {
        const turn = Math.min(1, Math.max(0, exactPage - index));
        setSheet(sheet, index, current, turn);
      });

      if (progressLabel) progressLabel.textContent = `${String(current + 1).padStart(2, "0")} / ${String(sheets.length).padStart(2, "0")}`;
      if (progressBar) progressBar.style.width = `${Math.max(4, progress * 100)}%`;
    };

    let queued = false;
    const requestUpdate = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => { queued = false; update(); });
    };

    update();
    window.addEventListener("scroll", requestUpdate, { passive: true });
    window.addEventListener("resize", requestUpdate);
  };

  setupScrollNotebook();
  document.addEventListener("astro:page-load", setupScrollNotebook);
</script>
