---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Marquee from "../components/Marquee.astro";
import { contentCards, favoriteGames, favoriteMusic, playlist, socials } from "../data/site";
---

<BaseLayout>
  <SiteHeader />
  <main>
    <section class="soft-hero">
      <div class="soft-dots" aria-hidden="true"></div>
      <span class="doodle doodle--heart" aria-hidden="true">♡</span>
      <span class="doodle doodle--bow" aria-hidden="true">୨୧</span>
      <div class="shell soft-hero__grid">
        <div class="soft-hero__copy">
          <p class="bubble-label">hiii!! you found me</p>
          <h1 class="soft-hero__title">hii, i’m<br /><em>Mochiko!</em></h1>
          <p class="soft-hero__lede">loud here, extremely quiet in real life. i play games, collect things i do not need, and get distracted by every single one of them.</p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a class="button button--pink" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-live-link>
              <i class="ph-fill ph-heart" aria-hidden="true"></i><span data-live-label>come watch me!</span>
            </a>
            <a class="button button--white" href="/content">my videos <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
          </div>
          <nav class="hero-socials" aria-label="Find Mochiko online">
            {socials.map((social) => (
              <a href={social.href} target="_blank" rel="noreferrer">
                <i class:list={["ph", social.icon]} aria-hidden="true"></i>
                <span>{social.label}</span>
              </a>
            ))}
          </nav>
          <div class="mini-note"><span>status.exe</span><strong>probably still in the settings menu</strong></div>
        </div>

        <div class="soft-hero__art">
          <div class="hero-cloud" aria-hidden="true"></div>
          <span class="sticker sticker--top" aria-hidden="true">look!!<br />it’s me</span>
          <span class="sticker sticker--bottom" aria-hidden="true">♡</span>
          <img src="/assets/model.webp" alt="Mochiko" width="1200" height="1600" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="home-live" data-home-live>
      <div class="shell home-live__inner">
        <img class="home-live__acrobat" src="/assets/acrobat.webp" alt="" width="1254" height="1254" loading="lazy" />
        <span class="home-live__badge"><i class="ph-fill ph-circle" aria-hidden="true"></i><span data-home-live-status>checking Twitch...</span></span>
        <div class="home-live__copy">
          <strong data-home-live-title>am i live?</strong>
          <span data-home-live-detail>one sec, i’m looking!!</span>
        </div>
        <a class="button button--white" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer" data-home-live-button>open Twitch <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </section>

    <Marquee sitter={{ src: "/assets/cute-pose2.webp", alt: "Mochiko sitting with a bunny plush", width: 1086, height: 1448 }} />

    <section class="section-pad bg-white">
      <div class="shell grid min-w-0 gap-10 lg:grid-cols-[minmax(0,0.82fr)_minmax(0,1.18fr)] lg:items-center lg:gap-18">
        <div class="soft-photo">
          <div class="soft-photo__dots" aria-hidden="true"></div>
          <img src="/assets/about.webp" alt="Mochiko smiling" width="900" height="1125" loading="lazy" />
          <span class="soft-photo__tag">hiii ♡</span>
        </div>
        <div class="min-w-0">
          <p class="section-kicker">about me</p>
          <h2 class="section-title mt-4">i said one round<br /><em>that was four hours ago</em></h2>
          <p class="body-lede mt-6">it was supposed to be a short session. then i started one more district, opened one more menu, and the sun came up.</p>
          <a class="button button--ink mt-7" href="/about">there’s more <i class="ph ph-heart" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="section-pad friend-feature">
      <div class="shell friend-feature__grid">
        <div class="friend-feature__photo">
          <img src="/assets/friends/mochiko-jannik-pose-3.webp" alt="Mochiko and Jannik standing together" width="788" height="1400" loading="lazy" />
          <span>PLAYER 2</span>
        </div>
        <div>
          <p class="section-kicker">me & Jannik</p>
          <h2 class="section-title mt-4">player two<br /><em>has entered</em></h2>
          <p class="body-lede mt-6">we play together a lot. somehow the easy part always takes us the longest.</p>
          <a class="button button--ink mt-7" href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">Jannik’s website <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="section-pad favorites-preview decorated-section" id="favorites">
      <div class="shell">
        <div class="soft-heading">
          <div>
            <p class="section-kicker">current favorites</p>
            <h2 class="section-title mt-4">stuff i’m stuck on</h2>
          </div>
          <a class="text-link" href="/about#favorites">the full ranking <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>

        <div class="favorites-preview__grid mt-10">
          <div class="mini-game-stack" aria-label="Top three favorite games">
            {favoriteGames.slice(0, 3).map((game, index) => (
              <a class="mini-game" href={game.href} target="_blank" rel="noreferrer" style={`--stack-index:${index}`}>
                <img src={game.image} alt={`${game.title} cover`} width="600" height="800" loading="lazy" />
                <span>#{game.rank}</span>
              </a>
            ))}
          </div>

          <div class="music-preview">
            <img class="music-preview__cover" src={favoriteMusic.songImage} alt={`${favoriteMusic.song} cover`} width="1000" height="1000" loading="lazy" />
            <div class="music-preview__copy">
              <span>on repeat!!</span>
              <h3>{favoriteMusic.song}</h3>
              <p>{favoriteMusic.songDetail}</p>
              <a href={favoriteMusic.songHref} target="_blank" rel="noreferrer">listen <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
            </div>
            <img class="music-preview__artist" src={favoriteMusic.artistImage} alt={favoriteMusic.artist} width="1080" height="1080" loading="lazy" />
          </div>

          <article class="playlist-embed">
            <div class="playlist-embed__bar">
              <span><i class="ph-fill ph-spotify-logo" aria-hidden="true"></i> {playlist.provider.toLowerCase()} · {playlist.label}</span>
              <div aria-hidden="true"><i></i><i></i><i></i></div>
            </div>

            <div class="playlist-embed__body">
              <div class="playlist-embed__cover">
                <img src={playlist.cover} alt="" width="1000" height="1000" loading="lazy" />
                <span aria-hidden="true"><i class="ph-fill ph-play"></i></span>
              </div>

              <div class="playlist-embed__screen">
                <span class="playlist-embed__eyebrow">playlist</span>
                <h3>{playlist.title}</h3>
                <p>{playlist.note}</p>

                <ol class="playlist-embed__queue">
                  <li><b>01</b><span>{playlist.topTrack}</span><i class="ph-fill ph-waveform" aria-hidden="true"></i></li>
                  <li><b>02</b><span>everything else i refuse to skip</span><i class="ph ph-dots-three" aria-hidden="true"></i></li>
                </ol>

                <div class="playlist-embed__transport">
                  <div class="playlist-embed__controls" aria-hidden="true">
                    <i class="ph-fill ph-skip-back"></i>
                    <span><i class="ph-fill ph-play"></i></span>
                    <i class="ph-fill ph-skip-forward"></i>
                    <i class="ph-fill ph-repeat"></i>
                  </div>
                  <div class="playlist-embed__progress" aria-hidden="true"><i></i></div>
                </div>

                <a class="playlist-embed__open" href={playlist.href} target="_blank" rel="noreferrer">
                  open on {playlist.provider} <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="shell">
        <div class="soft-heading">
          <div>
            <p class="section-kicker">what i post</p>
            <h2 class="section-title mt-4">pick something ♡</h2>
          </div>
          <a class="text-link" href="/content">see the newest stuff <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="mt-10 grid gap-5 md:grid-cols-3">
          {contentCards.map((card) => (
            <a class="squishy-card" href="/content">
              <div class="squishy-card__image"><img src={card.image} alt={card.alt} width="800" height="600" loading="lazy" /></div>
              <div class="squishy-card__body">
                <span class="squishy-card__icon"><i class:list={["ph", card.icon]} aria-hidden="true"></i></span>
                <div><h3>{card.title}</h3><p>{card.copy}</p></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const updateHomeLive = () => {
    const homeLive = document.querySelector<HTMLElement>("[data-home-live]");
    if (!homeLive) return;
    const status = homeLive.querySelector<HTMLElement>("[data-home-live-status]");
    const title = homeLive.querySelector<HTMLElement>("[data-home-live-title]");
    const detail = homeLive.querySelector<HTMLElement>("[data-home-live-detail]");
    const button = homeLive.querySelector<HTMLElement>("[data-home-live-button]");

    fetch("/api/twitch")
      .then((response) => response.json())
      .then((data) => {
        const live = data?.live?.isLive === true;
        homeLive.dataset.isLive = String(live);
        if (status) status.textContent = live ? "live right now!!" : "not live rn";
        if (title) title.textContent = live ? (data.live.title || "come watch!!") : "the chair is empty";
        if (detail) detail.textContent = live ? (data.live.gameName || "we’re doing something") : "i’ll be back. probably with a different game than the one i announced.";
        if (button) button.firstChild!.textContent = live ? "watch now " : "open Twitch ";
      })
      .catch(() => {
        if (status) status.textContent = "Twitch";
        if (title) title.textContent = "go peek?";
        if (detail) detail.textContent = "Twitch didn’t tell me anything.";
      });
  };

  const maybeUpdateHomeLive = () => {
    const homeLive = document.querySelector<HTMLElement>("[data-home-live]");
    if (!homeLive) return;
    if (document.documentElement.dataset.privacyChoice === "accepted") updateHomeLive();
    else if (document.documentElement.dataset.privacyChoice === "declined") {
        const status = homeLive.querySelector<HTMLElement>("[data-home-live-status]");
        const title = homeLive.querySelector<HTMLElement>("[data-home-live-title]");
        const detail = homeLive.querySelector<HTMLElement>("[data-home-live-detail]");
        if (status) status.textContent = "not loaded";
        if (title) title.textContent = "Twitch is tucked away";
        if (detail) detail.textContent = "you can still open the channel directly.";
    }
  };

  maybeUpdateHomeLive();
  window.addEventListener("mochiko:privacy-choice", maybeUpdateHomeLive);
  document.addEventListener("astro:page-load", maybeUpdateHomeLive);
</script>
