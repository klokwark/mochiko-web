---
import CreatorLayout from "../layouts/CreatorLayout.astro";
import VideoFeed from "../components/VideoFeed.astro";
import { contentCards } from "../data/site";
---
<CreatorLayout home heroTitle="hii, i’m Mochiko!" heroSubtitle="you can call me Mochi. welcome to my little corner.">
  <div class="hello-strip"><i class="ph ph-sparkle" aria-hidden="true"></i><p>games, videos, and things i got a little too invested in.</p><span>MAKE YOURSELF AT HOME</span></div>
  <div class="section-heading"><h2><i class="ph ph-heart" aria-hidden="true"></i>around here</h2><span class="eyebrow">A LITTLE OF EVERYTHING</span></div>
  <nav class="feed-tabs card" aria-label="Explore Mochiko’s content"><a class="selected" href="#creator-feed">a bit of everything</a><a href="/content#stream">streams</a><a href="/content#videos">videos</a><a href="/about">about me</a></nav>
  <div class="creator-feed" id="creator-feed">
    {contentCards.map((card, index) => <article class:list={["card creator-card", `creator-card--${index}`]}>
      <a class="creator-cover" href={index === 2 ? "/about" : "/content"} aria-label={index === 2 ? "About Mochiko" : `Watch Mochiko: ${card.title}`}>
        <span class="cover-label">MOCHI / {card.title.toUpperCase()}</span><img src={card.image} alt={card.alt} width="800" height="800" loading="lazy" /><span class="cover-sparkle" aria-hidden="true">✧</span>
      </a>
      <div class="creator-copy"><span class="eyebrow"><i class:list={["ph", card.icon]} aria-hidden="true"></i> {index === 2 ? "OFF STREAM" : "ON & OFF STREAM"}</span><h3><a href={index === 2 ? "/about" : "/content"}>{["one more game", "i have things to say", "the plushies stay"][index]}</a></h3><p>{card.copy}</p><a class="text-link" href={index === 2 ? "/about" : "/content"}>{index === 2 ? "a little about me" : "watch something"}<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div>
    </article>)}
  </div>
  <VideoFeed />
  <a class="card schedule-preview" href="/schedule"><i class="ph ph-calendar-dots" aria-hidden="true"></i><span><strong>when’s the next stream?</strong><small>the Twitch schedule, in your timezone.</small></span><i class="ph ph-arrow-right" aria-hidden="true"></i></a>
</CreatorLayout>
