---
import CreatorLayout from "../layouts/CreatorLayout.astro";
---
<CreatorLayout title="Stream schedule | Mochiko" description="See Mochiko’s upcoming Twitch streams in your own timezone." heroTitle="when i’m streaming" heroSubtitle="all times below follow your clock.">
  <section class="card page-card schedule-panel">
    <div class="section-heading"><h2><i class="ph ph-calendar-dots" aria-hidden="true"></i>next streams</h2></div>
    <p class="timezone"><i class="ph ph-clock" aria-hidden="true"></i><span data-schedule-zone>your timezone</span></p>
    <div data-schedule-list aria-live="polite"><div class="media-state"><img src="/assets/emotions/loading.webp" width="100" height="130" alt="" loading="lazy" /><div><h3>the calendar is tucked away</h3><p>Allow optional media to load my Twitch schedule.</p><button class="btn secondary" type="button" data-open-privacy>privacy choices</button></div></div></div>
    <a class="text-link schedule-link" href="https://www.twitch.tv/mochikolive/schedule" target="_blank" rel="noreferrer">the full calendar on Twitch<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
  </section>
  <section class="card schedule-note"><div><span class="eyebrow">SMALL PRINT</span><h2>plans do move</h2><p>this list follows my Twitch schedule. if nothing is listed, check the channel for updates.</p><a class="text-link" href="/content">watch something meanwhile<i class="ph ph-arrow-right" aria-hidden="true"></i></a></div><img src="/assets/umbrella-2.webp" alt="Mochiko holding an umbrella" width="1086" height="1448" loading="lazy" /></section>
</CreatorLayout>
