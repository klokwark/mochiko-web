---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

const fallbackDays = ["mo", "di", "mi", "do", "fr", "sa", "so"];
---

<BaseLayout title="Streamplan | Mochiko" description="Wann Mochiko als Nächstes auf Twitch live ist, direkt in deiner Zeitzone.">
  <SiteHeader />
  <main data-schedule-page>
    <section class="scene-hero scene-hero--right">
      <div class="shell scene-hero__grid">
        <div class="scene-frame scene-frame--rooftop">
          <img src="/assets/scenes/sunset-rooftop.webp" alt="" width="1672" height="941" fetchpriority="high" />
        </div>
        <div class="scene-card">
          <p class="kicker">streamplan</p>
          <h1 class="title-xl">wann bin ich<br /><em>live?</em></h1>
          <p class="lede">die zeiten sind schon in deiner zeitzone, du musst also nix umrechnen</p>
          <div class="jump-row">
            <span><i class="ph-fill ph-clock" aria-hidden="true"></i> <b data-schedule-zone>deine zeitzone</b></span>
            <a href="#planner"><i class="ph ph-arrow-down" aria-hidden="true"></i> zur liste</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad sched-planner" id="planner">
      <div class="shell sched-planner__grid">
        <article class="planner">
          <div class="planner__head">
            <div>
              <p class="kicker">demnächst</p>
              <h2 class="title-lg">nächste <em>streams</em></h2>
            </div>
            <div class="planner__status" data-schedule-status>
              <span class="porthole"><img src="/assets/emotions/wondering.webp" alt="" width="1254" height="1254" data-schedule-mood /></span>
              <span><b data-schedule-state>noch nicht geladen</b><small data-schedule-note>sag erst im datenschutz-fenster okay</small></span>
            </div>
          </div>

          <ul class="planner__week" data-schedule-week aria-label="Tage mit geplantem Stream">
            {fallbackDays.map((day) => <li><span>{day}</span></li>)}
          </ul>

          <div class="planner__list" data-schedule-list aria-live="polite">
            {[0, 1, 2].map(() => <div class="schedule-item schedule-item--skeleton" aria-hidden="true"><span></span><div><b></b><i></i></div></div>)}
          </div>

          <div class="planner__empty hidden" data-schedule-fallback>
            <i class="ph-fill ph-calendar-x" aria-hidden="true"></i>
            <div><strong data-schedule-fallback-title>grad nix da</strong><span data-schedule-fallback-copy>guck mal auf twitch, falls sich was geändert hat</span></div>
            <button class="button button--cream" type="button" data-open-privacy data-schedule-privacy hidden>datenschutz-einstellungen</button>
          </div>

          <a class="text-link planner__open" href="https://www.twitch.tv/mochikolive/schedule" target="_blank" rel="noreferrer">
            ganzer streamplan auf twitch <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
          </a>
        </article>

        <aside class="sched-pose">
          <div class="sched-pose__arch">
            <img src="/assets/outfits/outfit-5.webp" alt="Mochiko in einem schwarz-weißen Rüschenoutfit, die Kopfhörer in der Hand" width="941" height="1672" loading="lazy" />
          </div>
          <p class="sticker-label sched-pose__note">man sieht sich!</p>
        </aside>
      </div>
    </section>

    <section class="sched-note scallop-top">
      <div class="shell sched-note__grid">
        <img class="sched-note__art" src="/assets/umbrella-2.webp" alt="Mochiko mit einem zugeklappten Regenschirm" width="1122" height="1402" loading="lazy" />
        <div>
          <p class="kicker">kurz noch was</p>
          <h2 class="title-lg">pläne ändern sich <em>manchmal</em></h2>
          <p class="lede">wenn sich ein stream verschiebt, passt sich die liste von allein an. die kommt nämlich direkt von twitch.</p>
        </div>
        <a class="button button--pink" href="/content">jetzt was gucken <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { getTwitch, onPrivacyChoice, upcomingStreams, type ScheduledStream } from "../scripts/live";

  const weekdayLabels = () => {
    const formatter = new Intl.DateTimeFormat("de-DE", { weekday: "short" });
    // 2024-01-01 was a Monday, so this walks Mon..Sun in order.
    return Array.from({ length: 7 }, (_, index) => {
      const day = new Date(Date.UTC(2024, 0, 1 + index, 12));
      return { index: day.getUTCDay(), label: formatter.format(day).toLowerCase().replace(/\.$/, "") };
    });
  };

  const renderWeek = (activeDays: Set<number>) => {
    const week = document.querySelector("[data-schedule-week]");
    if (!week) return;
    week.replaceChildren(...weekdayLabels().map(({ index, label }) => {
      const item = document.createElement("li");
      if (activeDays.has(index)) item.className = "is-on";
      const text = document.createElement("span");
      text.textContent = label;
      item.append(text);
      return item;
    }));
  };

  const setStatus = (state: string, note: string, mood: string) => {
    const stateEl = document.querySelector("[data-schedule-state]");
    const noteEl = document.querySelector("[data-schedule-note]");
    const moodEl = document.querySelector<HTMLImageElement>("[data-schedule-mood]");
    if (stateEl) stateEl.textContent = state;
    if (noteEl) noteEl.textContent = note;
    if (moodEl) moodEl.src = `/assets/emotions/${mood}.webp`;
  };

  const showFallback = (title: string, copy: string, privacy: boolean) => {
    const list = document.querySelector("[data-schedule-list]");
    const fallback = document.querySelector<HTMLElement>("[data-schedule-fallback]");
    list?.classList.add("hidden");
    if (!fallback) return;
    fallback.classList.remove("hidden");
    const titleEl = fallback.querySelector("[data-schedule-fallback-title]");
    const copyEl = fallback.querySelector("[data-schedule-fallback-copy]");
    if (titleEl) titleEl.textContent = title;
    if (copyEl) copyEl.textContent = copy;
    const button = fallback.querySelector<HTMLElement>("[data-schedule-privacy]");
    if (button) button.hidden = !privacy;
    renderWeek(new Set());
  };

  const dayBadge = (date: Date) => {
    const start = new Date();
    start.setHours(0, 0, 0, 0);
    const diff = Math.round((new Date(date).setHours(0, 0, 0, 0) - start.getTime()) / 86_400_000);
    if (diff === 0) return "heute";
    if (diff === 1) return "morgen";
    return "";
  };

  const makeItem = (stream: ScheduledStream) => {
    const date = new Date(stream.startTime);
    const card = document.createElement("article");
    card.className = "schedule-item";

    const dateTile = document.createElement("time");
    dateTile.dateTime = stream.startTime;
    const weekday = document.createElement("span");
    weekday.textContent = new Intl.DateTimeFormat("de-DE", { weekday: "short" }).format(date).toLowerCase().replace(/\.$/, "");
    const day = document.createElement("strong");
    day.textContent = new Intl.DateTimeFormat("de-DE", { day: "numeric" }).format(date);
    const month = document.createElement("small");
    month.textContent = new Intl.DateTimeFormat("de-DE", { month: "short" }).format(date).toLowerCase().replace(/\.$/, "");
    dateTile.append(weekday, day, month);

    const copy = document.createElement("div");
    const badgeText = dayBadge(date);
    if (badgeText) {
      const badge = document.createElement("em");
      badge.textContent = badgeText;
      copy.append(badge);
    }
    const heading = document.createElement("h3");
    heading.textContent = stream.title || "stream!";
    const meta = document.createElement("p");
    meta.textContent = stream.category || "game steht noch nicht fest";
    copy.append(heading, meta);

    const time = document.createElement("span");
    time.className = "schedule-item__time";
    time.textContent = new Intl.DateTimeFormat("de-DE", { hour: "numeric", minute: "2-digit" }).format(date);

    card.append(dateTile, copy, time);
    return card;
  };

  const loadSchedule = async () => {
    const list = document.querySelector("[data-schedule-list]");
    const fallback = document.querySelector("[data-schedule-fallback]");
    if (!list || !fallback) return;
    setStatus("checke grad...", "eine sek!", "loading");
    try {
      const data = await getTwitch();
      if (!data.schedule) throw new Error("Schedule unavailable");
      const streams = upcomingStreams(data.schedule);
      if (!streams.length) {
        showFallback("noch nix geplant", "guck bald nochmal rein oder direkt auf twitch, falls sich was geändert hat", false);
        setStatus("nix geplant", "noch alles leer", "sad");
        return;
      }
      list.replaceChildren(...streams.map(makeItem));
      list.classList.remove("hidden");
      fallback.classList.add("hidden");
      renderWeek(new Set(streams.map((stream) => new Date(stream.startTime).getDay())));
      setStatus(`${streams.length} stream${streams.length === 1 ? "" : "s"} geplant`, "alles in deiner zeitzone", "happy");
    } catch {
      showFallback("konnte den streamplan nicht laden", "twitch antwortet grad nicht, aber der ganze plan steht auf meinem kanal", false);
      setStatus("hmm", "da hakt was", "surprised");
    }
  };

  const showZone = () => {
    const zone = document.querySelector("[data-schedule-zone]");
    if (!zone) return;
    try {
      zone.textContent = Intl.DateTimeFormat("de-DE").resolvedOptions().timeZone?.replace(/_/g, " ") || "deine zeitzone";
    } catch {
      zone.textContent = "deine zeitzone";
    }
  };

  onPrivacyChoice((choice) => {
    if (!document.querySelector("[data-schedule-page]")) return;
    showZone();
    if (choice === "accepted") {
      loadSchedule();
      return;
    }
    if (choice === "declined") {
      showFallback("die liste bleibt leer", "du hast nein zu twitch gesagt, deshalb lädt hier nix. den ganzen plan gibt’s aber auf meiner twitch-seite", true);
      setStatus("twitch ist aus", "deine entscheidung, alles gut", "wondering");
      return;
    }
    showFallback("noch nicht geladen", "klick im datenschutz-fenster auf „okay, laden“, dann tauchen meine nächsten streams hier auf", false);
    setStatus("noch nicht geladen", "sag erst im datenschutz-fenster okay", "wondering");
  });
</script>
