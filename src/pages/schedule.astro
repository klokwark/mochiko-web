---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import PageIntro from "../components/PageIntro.astro";
---

<BaseLayout title="Schedule | Mochiko" description="Find out when Mochiko is live next.">
  <SiteHeader />
  <main>
    <PageIntro eyebrow="Stream schedule" title="Let’s meet" accent="online." description="My schedule changes with the week. Twitch always has the newest stream time and the fastest way to know when I go live." index="03" />

    <section class="schedule-stage border-t-2 border-ink">
      <div class="shell grid min-w-0 gap-10 py-14 lg:grid-cols-[minmax(0,1fr)_minmax(20rem,0.72fr)] lg:items-center lg:py-20">
        <div class="schedule-art">
          <img src="/assets/gaming-2.png" alt="Mochiko gaming with a controller" width="1200" height="1600" fetchpriority="high" />
          <span>next stream</span>
        </div>
        <div class="schedule-card">
          <div class="schedule-card__top">
            <span>Live updates</span>
            <i class="ph-fill ph-circle" aria-hidden="true"></i>
          </div>
          <p class="font-display text-[clamp(2.4rem,6vw,4.7rem)] leading-[0.92] font-bold tracking-[-0.05em]">The next adventure is loading.</p>
          <p class="mt-6 text-base leading-relaxed font-semibold text-ink/62">Follow the Twitch channel to get notified as soon as the next stream is scheduled.</p>
          <a class="button button--ink mt-8 w-full" href="https://www.twitch.tv/mochikotv" target="_blank" rel="noreferrer">Open Twitch <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
