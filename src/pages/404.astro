---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Seite nicht gefunden | Mochiko" description="Diese Seite gibt es nicht." robots="noindex, nofollow">
  <main class="lost">
    <div class="lost__floor" aria-hidden="true"></div>

    <a class="lost__brand" href="/" aria-label="Startseite von Mochiko">
      <span><img src="/assets/bunny-mark.webp" alt="" width="224" height="224" /></span>
      Mochiko
    </a>

    <section class="lost__stage" aria-labelledby="lost-title">
      <div class="lost__visual">
        <div class="lost__code" aria-hidden="true"><b>4</b><span>0</span><b>4</b></div>
        <div class="lost__portal" aria-hidden="true"><i></i></div>
        <img class="lost__me" src="/assets/acrobat.webp" alt="Mochiko purzelt kopfüber aus einem Portal" width="1254" height="1254" fetchpriority="high" />
        <span class="lost__oops" aria-hidden="true">ups!!</span>
      </div>

      <div class="lost__copy">
        <p class="lost__eyebrow"><i class="ph-fill ph-warning" aria-hidden="true"></i> fehler 404</p>
        <h1 id="lost-title">diese seite<br /><em>gibt’s nicht</em></h1>
        <p>vielleicht ist der link veraltet oder ich hab mal wieder was kaputtgemacht. sorry!!</p>
        <div class="lost__actions">
          <a class="button button--pink" href="/">zurück zum start <i class="ph-fill ph-house" aria-hidden="true"></i></a>
          <a class="button button--cream" href="/content">videos gucken <i class="ph-fill ph-play-circle" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
