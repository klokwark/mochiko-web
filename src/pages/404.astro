---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found | Mochiko" description="This page seems to have wandered off." robots="noindex, follow">
  <main class="not-found" id="main-content">
    <div class="lost-number" aria-hidden="true">404</div>
    <img class="lost-mochi" src="/assets/acrobat.webp" alt="Mochiko tumbling through a missing page" width="1254" height="1254" />
    <div class="lost-copy"><span class="eyebrow">PAGE NOT FOUND</span><h1>well. that’s not a page.</h1><p>the link might be old, or i moved something.</p><div><a class="btn" href="/">take me home</a><a class="btn secondary" href="/content">show me videos</a></div></div>
    <p class="lost-credit">Theme: <a href="https://github.com/sudoriaa/Kanade-Astro/tree/codex/astro-theme" target="_blank" rel="noreferrer">Kanade by sudoriaa</a></p>
  </main>
</BaseLayout>
