---
import BaseLayout from "../layouts/BaseLayout.astro";

const missingPath = Astro.url.pathname;
---

<BaseLayout title="Page not found | Mochiko" description="This page wandered off." robots="noindex, nofollow">
  <main class="lost-page">
    <div class="lost-window">
      <div class="lost-window__bar">
        <span><img src="/assets/mochiko-logo-bunny-black.webp" alt="" width="1254" height="1254" /> page_not_found.exe</span>
        <div aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <div class="lost-window__body">
        <p class="lost-window__code">ERROR 404 // {missingPath}</p>
        <h1>wrong turn!!<br /><em>i fell off the page.</em></h1>
        <p>good news: i found the floor. bad news: your page is not here.</p>
        <div class="lost-window__actions">
          <a class="button button--pink" href="/">home <i class="ph ph-house" aria-hidden="true"></i></a>
          <a class="button button--white" href="/content">videos <i class="ph ph-play-circle" aria-hidden="true"></i></a>
        </div>
      </div>
    </div>

    <div class="lost-page__art-wrap">
      <span class="lost-page__sticker">totally planned this</span>
      <span class="lost-page__number" aria-hidden="true">404</span>
      <img src="/assets/acrobat.webp" alt="Mochiko balancing upside down" class="lost-page__art" width="1254" height="1254" />
    </div>
  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
