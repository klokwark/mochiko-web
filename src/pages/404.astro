---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Mochiko" description="This page wandered off." robots="noindex, nofollow">
  <main class="lost-page">
    <span class="lost-page__heart lost-page__heart--one" aria-hidden="true">♡</span>
    <span class="lost-page__heart lost-page__heart--two" aria-hidden="true">୨୧</span>
    <div class="lost-page__copy">
      <img src="/assets/mochiko-logo-bunny-black.webp" alt="" class="lost-page__logo" width="1254" height="1254" />
      <p class="bubble-label">error 404 // oopsie!!</p>
      <h1 class="page-title">this page got<br /><em>a lil lost ♡</em></h1>
      <p>i don’t think this page exists. let’s go back!</p>
      <a class="button button--pink" href="/">take me home <i class="ph ph-house" aria-hidden="true"></i></a>
    </div>
    <img src="/assets/cute-pose-1.webp" alt="Mochiko sitting with a bunny plush" class="lost-page__art" width="1086" height="1448" />
  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
