---
import BaseLayout from "../layouts/BaseLayout.astro";

const missingPath = Astro.url.pathname;
---

<BaseLayout title="Page not found | Mochiko" description="This page wandered off." robots="noindex, nofollow">
  <main class="lost-page">
    <div class="lost-window">
      <div class="lost-window__bar">
        <span><img src="/assets/mochiko-logo-bunny-black.webp" alt="" width="1254" height="1254" /> page_not_found.exe</span>
        <div aria-hidden="true"><i></i><i></i><i></i></div>
      </div>
      <div class="lost-window__body">
        <p class="lost-window__code">ERROR 404 // {missingPath}</p>
        <h1>uh oh.<br /><em>this button does nothing.</em></h1>
        <p>i checked twice. this page is not in the folder.</p>
        <div class="lost-window__actions">
          <a class="button button--pink" href="/">home <i class="ph ph-house" aria-hidden="true"></i></a>
          <a class="button button--white" href="/content">videos <i class="ph ph-play-circle" aria-hidden="true"></i></a>
        </div>
        <span class="lost-window__status"><i class="ph-fill ph-circle" aria-hidden="true"></i> task failed successfully</span>
      </div>
    </div>

    <div class="lost-page__art-wrap">
      <span class="lost-page__sticker">where did it go??</span>
      <img src="/assets/headphones-sitting.webp" alt="Mochiko sitting with headphones" class="lost-page__art" width="941" height="1672" />
      <img src="/assets/emotions/sad.webp" alt="" class="lost-page__emotion" width="1254" height="1254" aria-hidden="true" />
    </div>

    <div class="lost-taskbar" aria-hidden="true">
      <img src="/assets/mochiko-logo-bunny-black.webp" alt="" width="1254" height="1254" />
      <span>404.exe</span>
      <i class="ph ph-wifi-slash"></i>
    </div>
  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
