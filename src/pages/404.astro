---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Mochiko" description="Mochiko fell out of the map." robots="noindex, nofollow">
  <main class="lost">
    <div class="lost__backdrop" aria-hidden="true"><i></i><i></i><i></i></div>

    <a class="lost__brand" href="/" aria-label="Mochiko home">
      <img src="/assets/bunny-mark.webp" alt="" width="512" height="512" />
      <span>Mochiko</span>
    </a>

    <section class="lost__stage" aria-labelledby="lost-title">
      <div class="lost__visual">
        <div class="lost__code" aria-hidden="true"><b>4</b><span>0</span><b>4</b></div>
        <div class="lost__portal" aria-hidden="true"><i></i></div>
        <img class="lost__me" src="/assets/acrobat.webp" alt="Mochiko tumbling out of the missing page" width="1254" height="1254" fetchpriority="high" />
        <span class="lost__oops" aria-hidden="true">wrong<br />button!!</span>
      </div>

      <div class="lost__copy">
        <p class="lost__eyebrow"><i class="ph-fill ph-game-controller" aria-hidden="true"></i> map failed to load</p>
        <h1 id="lost-title">i fell out<br /><em>of the map.</em></h1>
        <p>i pressed something before reading it. the page is gone now. unrelated, obviously.</p>
        <div class="lost__actions">
          <a class="button button--pink" href="/">respawn at home <i class="ph-fill ph-house" aria-hidden="true"></i></a>
          <a class="button button--white" href="/content">watch something <i class="ph-fill ph-play-circle" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
