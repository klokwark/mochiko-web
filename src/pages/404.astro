---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Mochiko" description="This page doesn’t exist." robots="noindex, nofollow">
  <main class="lost">
    <div class="lost__floor" aria-hidden="true"></div>

    <a class="lost__brand" href="/" aria-label="Mochiko home">
      <span><img src="/assets/bunny-mark.webp" alt="" width="224" height="224" /></span>
      Mochiko
    </a>

    <section class="lost__stage" aria-labelledby="lost-title">
      <div class="lost__visual">
        <div class="lost__code" aria-hidden="true"><b>4</b><span>0</span><b>4</b></div>
        <div class="lost__portal" aria-hidden="true"><i></i></div>
        <img class="lost__me" src="/assets/acrobat.webp" alt="Mochiko tumbling upside down out of a portal" width="1254" height="1254" fetchpriority="high" />
        <span class="lost__oops" aria-hidden="true">oops!!</span>
      </div>

      <div class="lost__copy">
        <p class="lost__eyebrow"><i class="ph-fill ph-warning" aria-hidden="true"></i> error 404</p>
        <h1 id="lost-title">this page<br /><em>doesn’t exist</em></h1>
        <p>maybe the link is old, or i broke something again. sorry!!</p>
        <div class="lost__actions">
          <a class="button button--pink" href="/">go home <i class="ph-fill ph-house" aria-hidden="true"></i></a>
          <a class="button button--cream" href="/content">watch something <i class="ph-fill ph-play-circle" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
