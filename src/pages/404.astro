---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found | Mochiko" description="This page wandered off." robots="noindex, nofollow">
  <main class="relative grid min-h-screen overflow-hidden bg-paper lg:grid-cols-[minmax(0,1fr)_minmax(24rem,0.8fr)]">
    <div class="hero-grid absolute inset-0 opacity-70"></div>
    <section class="relative z-10 flex min-w-0 flex-col justify-center px-6 py-16 sm:px-12 lg:px-[8vw]">
      <a href="/" class="brand-lockup focus-ring w-fit" aria-label="Mochiko home">
        <img src="/assets/mochiko-logo-bunny-black.png" alt="" class="brand-mark" width="1254" height="1254" />
        <span class="brand-name">Mochiko</span>
      </a>
      <p class="section-kicker mt-14">Error 404</p>
      <h1 class="page-title mt-5">Got a little<br /><em>lost?</em></h1>
      <p class="mt-7 max-w-md text-base leading-relaxed font-semibold text-ink/65">This page wandered off somewhere. Let’s get you back to the cozy part of the internet.</p>
      <a class="button button--pink mt-8 w-fit" href="/">Back home <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
    </section>
    <div class="relative z-10 flex min-h-[30rem] items-end justify-center overflow-hidden border-t-2 border-ink bg-pink lg:min-h-screen lg:border-t-0 lg:border-l-2">
      <div class="absolute inset-8 border-2 border-b-0 border-ink bg-white"></div>
      <img src="/assets/cute-pose-1.png" alt="Mochiko" class="relative z-10 max-h-[78vh] w-auto object-contain object-bottom" width="1200" height="1600" />
    </div>
  </main>
</BaseLayout>
