---
import BaseLayout from "../layouts/BaseLayout.astro";

const missingPath = Astro.url.pathname;

const stickers = [
  { src: "/assets/gaming-1.webp", tag: "♡" },
  { src: "/assets/outfits/outfit-6.webp", tag: "✦" },
  { src: "/assets/headphones-sitting.webp", tag: "♡" },
  { src: "/assets/gaming-3.webp", tag: "!!" },
  { src: "/assets/outfits/outfit-5.webp", tag: "✦" },
  { src: "/assets/friends/mochiko-jannik-pose-1.webp", tag: "2P" },
  { src: "/assets/mochikopfp.webp", tag: "♡" },
  { src: "/assets/friends/mochiko-jannik-gaming.webp", tag: "2P" },
];
---

<BaseLayout title="Page not found | Mochiko" description="This page wandered off." robots="noindex, nofollow">
  <main class="lost">
    <div class="lost__stickers" aria-hidden="true">
      {stickers.map((sticker, index) => (
        <span class:list={["lost-sticker", `lost-sticker--${index + 1}`]}>
          <img src={sticker.src} alt="" loading="lazy" />
          <b>{sticker.tag}</b>
        </span>
      ))}
    </div>

    <div class="lost__stage">
      <p class="lost__chip"><i class="ph-fill ph-heart-break" aria-hidden="true"></i> error 404 <b>{missingPath}</b></p>

      <div class="lost__hero">
        <span class="lost__number" aria-hidden="true">404</span>
        <img class="lost__me" src="/assets/avatar-main.webp" alt="Mochiko holding a bunny plush" width="1086" height="1448" fetchpriority="high" />
        <span class="lost__bubble">this page wandered off<br /><b>like a fox, but ruder</b></span>
      </div>

      <div class="lost__actions">
        <a class="button button--pink" href="/">take me home <i class="ph-fill ph-house" aria-hidden="true"></i></a>
        <a class="button button--white" href="/content">watch something <i class="ph-fill ph-play-circle" aria-hidden="true"></i></a>
      </div>
    </div>

    <div class="lost__ribbon" aria-hidden="true">
      <div>
        {[0, 1].map(() => (
          <span>{["lost", "not found", "oops", "try home ♡", "lost", "not found"].map((word) => <i>{word}</i>)}</span>
        ))}
      </div>
    </div>
  </main>
</BaseLayout>

<style is:global>
  html, body { height: 100%; overflow: hidden; }
</style>
