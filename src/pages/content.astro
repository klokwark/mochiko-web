---
import CreatorLayout from "../layouts/CreatorLayout.astro";
import VideoFeed from "../components/VideoFeed.astro";
import StreamPanel from "../components/StreamPanel.astro";
---
<CreatorLayout title="Streams & videos | Mochiko" description="Watch Mochiko’s live Twitch stream, newest YouTube uploads and latest VOD." heroTitle="streams, videos & more" heroSubtitle="the newest things, all in one place." image="/assets/scenes/gaming-bedroom.webp">
  <StreamPanel />
  <VideoFeed />
  <section class="feed-section" id="vod">
    <div class="section-heading"><h2><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i>missed a stream?</h2></div>
    <div class="card vod-panel" data-vod-panel aria-live="polite"><img src="/assets/gaming-2.webp" width="170" height="190" alt="" loading="lazy" /><div><span class="eyebrow">LATEST VOD</span><h3 data-vod-title>catch up on Twitch</h3><p data-vod-detail>Allow optional media to find the latest VOD here.</p><a class="btn secondary" data-vod-link href="https://www.twitch.tv/mochikolive/videos" target="_blank" rel="noreferrer">open VODs<i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div></div>
  </section>
</CreatorLayout>
