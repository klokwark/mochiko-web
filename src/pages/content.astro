---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Videos | Mochiko" description="Schau dir Mochikos neueste YouTube-Videos, ihr letztes Twitch-VOD und den Livestream an.">
  <SiteHeader />
  <main data-content-page>
    <section class="scene-hero">
      <div class="shell scene-hero__grid">
        <div class="scene-frame">
          <img src="/assets/scenes/gaming-bedroom.webp" alt="" width="1672" height="941" fetchpriority="high" />
        </div>
        <div class="scene-card">
          <p class="kicker">videos</p>
          <h1 class="title-xl">streams<br /><em>& videos</em></h1>
          <p class="lede">mein letzter stream und meine neuesten videos, alles auf einer seite</p>
          <nav class="jump-row" aria-label="Zu den Abschnitten">
            <a href="#live"><i class="ph-fill ph-broadcast" aria-hidden="true"></i> live</a>
            <a href="#videos"><i class="ph-fill ph-youtube-logo" aria-hidden="true"></i> videos</a>
            <a href="#vod"><i class="ph-fill ph-film-strip" aria-hidden="true"></i> letzter stream</a>
          </nav>
        </div>
      </div>
    </section>

    <section class="section-pad content-live" id="live">
      <div class="shell">
        <div class="section-head">
          <div>
            <p class="kicker">Twitch</p>
            <h2 class="title-lg">bin ich grad <em>live?</em></h2>
          </div>
        </div>

        <div class="live-grid" data-live-panel data-state="unset">
          <div class="player-window">
            <p class="player-window__bar">
              <span class="player-window__dots" aria-hidden="true"></span>
              <span class="player-window__url">twitch.tv/mochikolive</span>
              <span class="live-pill" data-live-pill><i class="ph-fill ph-circle" aria-hidden="true"></i><span>aus</span></span>
            </p>
            <div class="player-window__screen">
              <iframe
                data-twitch-player
                data-src="https://player.twitch.tv/?channel=mochikolive&parent=mochikotv.com&parent=www.mochikotv.com&autoplay=true&muted=true"
                title="Mochikos Twitch-Stream"
                allow="autoplay; fullscreen"
                allowfullscreen
              ></iframe>
              <div class="embed-locked" data-embed-locked>
                <i class="ph-fill ph-lock-key" aria-hidden="true"></i>
                <strong data-embed-title>twitch ist noch nicht geladen</strong>
                <span data-embed-copy>klick im datenschutz-fenster auf „okay, laden“, dann siehst du den player</span>
                <button class="button button--pink" type="button" data-open-privacy>datenschutz-einstellungen</button>
              </div>
            </div>
          </div>

          <aside class="live-side">
            <div class="live-side__copy">
              <span class="sticker-label" data-live-status>twitch</span>
              <h3 data-live-title>noch nicht geladen</h3>
              <p data-live-copy>erst okay sagen, dann lädt der player. wenn ich live bin, startet er von allein (ohne ton)</p>
              <a class="button button--ink" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer"><span data-live-cta>zu Twitch</span> <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
            </div>
            <img class="live-side__face" src="/assets/emotions/wondering.webp" alt="" width="1254" height="1254" data-live-face />
          </aside>
        </div>
      </div>
    </section>

    <section class="section-pad content-videos scallop-top" id="videos">
      <div class="shell">
        <div class="section-head content-videos__head">
          <div>
            <p class="kicker">YouTube</p>
            <h2 class="title-lg">neueste videos</h2>
          </div>
          <a class="text-link" href="https://www.youtube.com/@mochikotv" target="_blank" rel="noreferrer">mein kanal <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <img class="content-videos__me" src="/assets/avatar-main2.webp" alt="" width="1024" height="1536" loading="lazy" />
        </div>

        <div class="video-grid" data-youtube-grid aria-live="polite">
          {[0, 1, 2, 3].map(() => (
            <div class="video-card video-card--skeleton" aria-hidden="true"><span class="video-card__thumb"></span><span class="video-card__copy"><b></b><b></b><i></i></span></div>
          ))}
        </div>

        <div class="notice-card hidden" data-youtube-notice>
          <span class="porthole"><img src="/assets/emotions/wondering.webp" alt="" width="1254" height="1254" loading="lazy" data-youtube-notice-face /></span>
          <div>
            <strong data-youtube-notice-title>youtube ist noch nicht geladen</strong>
            <span data-youtube-notice-copy>sag im datenschutz-fenster okay, dann siehst du hier meine neuesten videos</span>
          </div>
          <div class="notice-card__actions">
            <a class="button button--ink" href="https://www.youtube.com/@mochikotv" target="_blank" rel="noreferrer">YouTube <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
            <button class="button button--cream" type="button" data-open-privacy data-youtube-notice-privacy hidden>datenschutz-einstellungen</button>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad content-vod" id="vod">
      <div class="shell">
        <div class="vod-card" data-vod-card data-state="unset" aria-live="polite">
          <div class="vod-card__art">
            <span class="vod-card__tape" aria-hidden="true">REC</span>
            <img src="/assets/gaming-2.webp" alt="" width="1086" height="1448" loading="lazy" />
          </div>
          <div class="vod-card__copy">
            <p class="kicker">Twitch</p>
            <h2 class="title-lg">letzter <em>stream</em></h2>
            <span class="sticker-label" data-vod-chip>letztes vod</span>
            <h3 data-vod-title>stream verpasst?</h3>
            <p data-vod-copy>sobald du okay sagst, taucht hier mein neuestes vod auf</p>
            <div class="button-row">
              <a class="button button--pink" href="https://www.twitch.tv/mochikolive/videos" target="_blank" rel="noreferrer" data-vod-link><span data-vod-cta>alle vods</span> <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
              <button class="button button--cream" type="button" data-open-privacy data-vod-privacy>datenschutz-einstellungen</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  import { formatStreamTime, getTwitch, onPrivacyChoice, upcomingStreams, type PrivacyChoice } from "../scripts/live";

  type VideoItem = { title: string; url: string; thumbnailUrl: string; publishedAt: string };
  type LiveState = "unset" | "declined" | "loading" | "live" | "offline" | "error";

  const faces: Record<LiveState, string> = {
    unset: "wondering",
    declined: "wondering",
    loading: "loading",
    live: "happy",
    offline: "sad",
    error: "surprised",
  };

  const prettyDate = (value: string) => new Intl.DateTimeFormat("de-DE", { month: "short", day: "numeric", year: "numeric" }).format(new Date(value));

  const setText = (root: ParentNode, selector: string, value: string) => {
    const element = root.querySelector(selector);
    if (element) element.textContent = value;
  };

  const renderLive = (state: LiveState, text: { pill: string; status: string; title: string; copy: string; cta?: string }) => {
    const panel = document.querySelector<HTMLElement>("[data-live-panel]");
    if (!panel) return;
    panel.dataset.state = state;
    setText(panel, "[data-live-pill] span", text.pill);
    setText(panel, "[data-live-status]", text.status);
    setText(panel, "[data-live-title]", text.title);
    setText(panel, "[data-live-copy]", text.copy);
    setText(panel, "[data-live-cta]", text.cta ?? "zu Twitch");
    const face = panel.querySelector<HTMLImageElement>("[data-live-face]");
    if (face) face.src = `/assets/emotions/${faces[state]}.webp`;
  };

  const setPlayer = (choice: PrivacyChoice) => {
    const player = document.querySelector<HTMLIFrameElement>("[data-twitch-player]");
    const locked = document.querySelector<HTMLElement>("[data-embed-locked]");
    if (!player || !locked) return;
    if (choice === "accepted") {
      if (player.dataset.src && player.getAttribute("src") !== player.dataset.src) player.src = player.dataset.src;
      locked.hidden = true;
      return;
    }
    player.removeAttribute("src");
    locked.hidden = false;
    setText(locked, "[data-embed-title]", choice === "declined" ? "twitch ist aus" : "twitch ist noch nicht geladen");
    setText(locked, "[data-embed-copy]", choice === "declined"
      ? "du hast nein zu externem kram gesagt, also lädt hier nix. passt schon!"
      : "klick im datenschutz-fenster auf „okay, laden“, dann siehst du den player");
  };

  const makeVideoCard = (video: VideoItem, index: number) => {
    const link = document.createElement("a");
    link.className = index === 0 ? "video-card video-card--featured" : "video-card";
    link.href = video.url;
    link.target = "_blank";
    link.rel = "noreferrer";

    const thumb = document.createElement("span");
    thumb.className = "video-card__thumb";
    const image = document.createElement("img");
    image.src = video.thumbnailUrl;
    image.alt = "";
    image.loading = "lazy";
    image.width = 480;
    image.height = 360;
    const play = document.createElement("i");
    play.className = "ph-fill ph-play";
    play.setAttribute("aria-hidden", "true");
    thumb.append(image, play);

    const copy = document.createElement("span");
    copy.className = "video-card__copy";
    if (index === 0) {
      const tag = document.createElement("small");
      tag.className = "video-card__tag";
      tag.textContent = "neu";
      copy.append(tag);
    }
    const title = document.createElement("strong");
    title.textContent = video.title;
    const date = document.createElement("small");
    date.textContent = prettyDate(video.publishedAt);
    copy.append(title, date);

    link.append(thumb, copy);
    return link;
  };

  const showVideoNotice = (kind: "fallback" | "locked" | "unset") => {
    const grid = document.querySelector<HTMLElement>("[data-youtube-grid]");
    const notice = document.querySelector<HTMLElement>("[data-youtube-notice]");
    if (!grid || !notice) return;
    grid.classList.add("hidden");
    notice.classList.remove("hidden");
    notice.dataset.kind = kind;
    const face = notice.querySelector<HTMLImageElement>("[data-youtube-notice-face]");
    if (face) face.src = `/assets/emotions/${kind === "fallback" ? "surprised" : "wondering"}.webp`;
    setText(notice, "[data-youtube-notice-title]", kind === "fallback" ? "youtube antwortet nicht" : kind === "locked" ? "youtube ist aus" : "youtube ist noch nicht geladen");
    setText(notice, "[data-youtube-notice-copy]", kind === "fallback"
      ? "meine videos gibt’s trotzdem auf meinem kanal!"
      : kind === "locked"
        ? "hast du so eingestellt, kannst du aber jederzeit ändern"
        : "sag im datenschutz-fenster okay, dann siehst du hier meine neuesten videos");
    const privacy = notice.querySelector<HTMLElement>("[data-youtube-notice-privacy]");
    if (privacy) privacy.hidden = kind === "fallback";
  };

  const loadYouTube = async () => {
    const grid = document.querySelector<HTMLElement>("[data-youtube-grid]");
    const notice = document.querySelector<HTMLElement>("[data-youtube-notice]");
    if (!grid || !notice || grid.dataset.loaded === "true") return;
    grid.dataset.loaded = "true";
    try {
      const response = await fetch("/api/youtube");
      const data = await response.json();
      if (!response.ok || !data.videos?.length) throw new Error("No videos available");
      grid.replaceChildren(...(data.videos as VideoItem[]).slice(0, 4).map(makeVideoCard));
      grid.classList.remove("hidden");
      notice.classList.add("hidden");
    } catch {
      showVideoNotice("fallback");
    }
  };

  const renderVod = (state: "unset" | "declined" | "loading" | "ready" | "fallback", video?: { title: string; url: string }) => {
    const card = document.querySelector<HTMLElement>("[data-vod-card]");
    if (!card) return;
    card.dataset.state = state;
    const link = card.querySelector<HTMLAnchorElement>("[data-vod-link]");
    const privacy = card.querySelector<HTMLElement>("[data-vod-privacy]");
    if (privacy) privacy.hidden = state !== "unset" && state !== "declined";
    if (link) link.href = video?.url ?? "https://www.twitch.tv/mochikolive/videos";

    const copy = {
      unset: ["letztes vod", "stream verpasst?", "sobald du okay sagst, taucht hier mein neuestes vod auf", "alle vods"],
      declined: ["twitch ist aus", "kann ich hier nicht zeigen", "alle meine vods findest du trotzdem auf twitch", "alle vods"],
      loading: ["lädt...", "eine sek!", "hol grad das neueste...", "alle vods"],
      ready: ["letztes vod", video?.title ?? "mein letzter stream", "der ganze stream, falls du ihn verpasst hast", "angucken"],
      fallback: ["twitch-vods", "gibt’s auf twitch", "hier hat’s nicht geklappt, aber auf meiner twitch-seite findest du’s", "alle vods"],
    }[state];

    setText(card, "[data-vod-chip]", copy[0]);
    setText(card, "[data-vod-title]", copy[1]);
    setText(card, "[data-vod-copy]", copy[2]);
    setText(card, "[data-vod-cta]", copy[3]);
  };

  onPrivacyChoice((choice) => {
    if (!document.querySelector("[data-content-page]")) return;
    setPlayer(choice);

    if (choice !== "accepted") {
      const grid = document.querySelector<HTMLElement>("[data-youtube-grid]");
      if (grid) grid.dataset.loaded = "";
      showVideoNotice(choice === "declined" ? "locked" : "unset");
      renderVod(choice);
      renderLive(choice, choice === "declined"
        ? { pill: "aus", status: "twitch ist aus", title: "kein player", copy: "alles gut! direkt auf twitch kannst du trotzdem zugucken" }
        : { pill: "aus", status: "twitch", title: "noch nicht geladen", copy: "erst okay sagen, dann lädt der player. wenn ich live bin, startet er von allein (ohne ton)" });
      return;
    }

    loadYouTube();
    const panel = document.querySelector<HTMLElement>("[data-live-panel]");
    if (panel?.dataset.state !== "live" && panel?.dataset.state !== "offline") {
      renderLive("loading", { pill: "checke grad...", status: "checke grad", title: "eine sek!", copy: "ich guck mal, ob ich live bin..." });
      renderVod("loading");
    }

    getTwitch()
      .then((data) => {
        if (!data.live) {
          renderLive("error", { pill: "twitch", status: "hmm", title: "twitch antwortet nicht", copy: "probier’s direkt auf meinem kanal, da sollte es trotzdem gehen" });
        } else if (data.live.isLive) {
          renderLive("live", {
            pill: "live!",
            status: data.live.gameName ? `zocke ${data.live.gameName}` : "grad live",
            title: data.live.title || "bin live!",
            copy: data.live.viewerCount ? `${data.live.viewerCount} zuschauer dabei. ist auf stumm, klick rein für ton` : "ist auf stumm, klick rein für ton",
            cta: "zum chat",
          });
        } else {
          const next = upcomingStreams(data.schedule)[0];
          renderLive("offline", {
            pill: "offline",
            status: "offline",
            title: "nicht live grad",
            copy: next
              ? `nächster stream: ${formatStreamTime(next.startTime)}${next.category ? ` ·\u00a0${next.category}` : ""}`
              : data.schedule ? "noch kein stream geplant. wenn ich live geh, startet der player von allein" : "wenn ich live geh, startet der player von allein. den streamplan gibt’s grad nur auf twitch",
          });
        }
        if (data.video?.url) renderVod("ready", data.video);
        else renderVod("fallback");
      })
      .catch(() => {
        renderLive("error", { pill: "twitch", status: "hmm", title: "twitch antwortet nicht", copy: "probier’s direkt auf meinem kanal, da sollte es trotzdem gehen" });
        renderVod("fallback");
      });
  });
</script>
