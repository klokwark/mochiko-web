---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout title="Content | Mochiko" description="Watch Mochiko’s newest YouTube videos, latest Twitch VOD, and live stream.">
  <SiteHeader />
  <main>
    <section class="content-hero">
      <div class="shell content-hero__grid">
        <div class="content-hero__copy">
          <p class="section-kicker">watch stuff</p>
          <h1>streams,<br /><em>videos & more ♡</em></h1>
          <p>the newest things are all here. no digging around.</p>
        </div>
        <div class="content-hero__art">
          <span aria-hidden="true">NEW!!</span>
          <img src="/assets/avatar-main2.png" alt="Mochiko in a black and white outfit" width="1024" height="1536" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="duo-strip">
      <div class="shell duo-strip__inner">
        <img src="/assets/friends/mochiko-jannik-pose-1.webp" alt="Jannik standing beside Mochiko" width="788" height="1400" loading="lazy" />
        <div><span>Jannik shows up on stream too</span><strong>we’re friends. don’t make it weird.</strong></div>
        <a href="https://www.jannikjbi.de/" target="_blank" rel="noreferrer">meet Jannik <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
      </div>
    </section>

    <section class="section-pad live-candy">
      <div class="shell">
        <div class="soft-heading">
          <div>
            <p class="section-kicker">Twitch</p>
            <h2 class="section-title mt-4">live right now?</h2>
          </div>
          <span class="live-status-pill" data-stream-status><i class="ph-fill ph-circle" aria-hidden="true"></i><span>checking...</span></span>
        </div>

        <div class="stream-card mt-9">
          <div class="stream-card__player">
            <iframe
              data-twitch-player
              data-src="https://player.twitch.tv/?channel=mochikolive&parent=mochikotv.com&parent=www.mochikotv.com&autoplay=true&muted=true"
              title="Mochiko’s Twitch stream"
              allow="autoplay; fullscreen"
              allowfullscreen
              loading="eager"
            ></iframe>
            <div class="embed-locked" data-embed-locked>
              <i class="ph ph-lock-key" aria-hidden="true"></i>
              <strong>Twitch is not loaded yet</strong>
              <span>choose “okay, load them” in the privacy box to show the player.</span>
              <button type="button" data-open-privacy>privacy choices</button>
            </div>
          </div>
          <div class="stream-card__side">
            <span class="cute-chip cute-chip--white"><i class="ph ph-twitch-logo" aria-hidden="true"></i> Twitch</span>
            <h3 data-stream-title>press play ♡</h3>
            <p data-stream-copy>when i’m live, it starts here automatically. chat is over on Twitch.</p>
            <a class="button button--ink" href="https://www.twitch.tv/mochikolive" target="_blank" rel="noreferrer">open Twitch <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </div>
      </div>
    </section>

    <section class="section-pad bg-white">
      <div class="shell">
        <div class="soft-heading">
          <div>
            <p class="section-kicker">YouTube</p>
            <h2 class="section-title mt-4">newest videos</h2>
          </div>
          <a class="text-link" href="https://www.youtube.com/@mochikotv" target="_blank" rel="noreferrer">open my channel <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>

        <div class="video-grid mt-9" data-youtube-grid aria-live="polite">
          {[0, 1, 2, 3].map(() => (
            <div class="video-skeleton" aria-hidden="true"><span></span><b></b><i></i></div>
          ))}
        </div>
        <div class="feed-fallback mt-6 hidden" data-youtube-fallback>
          <i class="ph ph-youtube-logo" aria-hidden="true"></i>
          <div><strong>the videos are over here ♡</strong><span>open YouTube to see the newest ones</span></div>
          <a href="https://www.youtube.com/@mochikotv" target="_blank" rel="noreferrer">YouTube <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>

    <section class="section-pad bg-paper">
      <div class="shell">
        <p class="section-kicker">Twitch</p>
        <h2 class="section-title mt-4">latest VOD</h2>
        <div class="vod-card mt-9" data-vod-card aria-live="polite">
          <div class="vod-card__placeholder"><i class="ph ph-spinner-gap" aria-hidden="true"></i></div>
          <div class="vod-card__copy"><span class="cute-chip">loading...</span><h3>getting the newest one ♡</h3></div>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />

  <script>
    type VideoItem = {
      title: string;
      url: string;
      thumbnailUrl: string;
      publishedAt: string;
    };

    const prettyDate = (value: string) => new Intl.DateTimeFormat(undefined, { month: "short", day: "numeric", year: "numeric" }).format(new Date(value));

    const makeVideoCard = (video: VideoItem) => {
      const link = document.createElement("a");
      link.className = "video-card";
      link.href = video.url;
      link.target = "_blank";
      link.rel = "noreferrer";

      const imageWrap = document.createElement("span");
      imageWrap.className = "video-card__image";
      const image = document.createElement("img");
      image.src = video.thumbnailUrl;
      image.alt = "";
      image.loading = "lazy";
      imageWrap.append(image);

      const copy = document.createElement("span");
      copy.className = "video-card__copy";
      const title = document.createElement("strong");
      title.textContent = video.title;
      const date = document.createElement("small");
      date.textContent = prettyDate(video.publishedAt);
      copy.append(title, date);

      const arrow = document.createElement("i");
      arrow.className = "ph ph-arrow-up-right";
      arrow.setAttribute("aria-hidden", "true");
      link.append(imageWrap, copy, arrow);
      return link;
    };

    const loadYouTube = async () => {
      const grid = document.querySelector("[data-youtube-grid]");
      const fallback = document.querySelector("[data-youtube-fallback]");
      if (!grid || !fallback) return;
      try {
        const response = await fetch("/api/youtube");
        const data = await response.json();
        if (!response.ok || !data.videos?.length) throw new Error("No videos available");
        grid.replaceChildren(...data.videos.slice(0, 4).map(makeVideoCard));
      } catch {
        grid.classList.add("hidden");
        fallback.classList.remove("hidden");
      }
    };

    const loadTwitch = async () => {
      const status = document.querySelector("[data-stream-status]");
      const statusText = status?.querySelector("span");
      const title = document.querySelector("[data-stream-title]");
      const copy = document.querySelector("[data-stream-copy]");
      const vodCard = document.querySelector("[data-vod-card]");
      try {
        const response = await fetch("/api/twitch");
        const data = await response.json();
        if (data.live?.isLive) {
          status?.classList.add("is-live");
          if (statusText) statusText.textContent = "live now!!";
          if (title) title.textContent = data.live.title || "i’m live right now!!";
          if (copy) copy.textContent = data.live.gameName ? `playing ${data.live.gameName} right now ♡` : "the stream is on right now ♡";
        } else if (statusText) {
          statusText.textContent = "offline for now";
        }

        if (vodCard && data.video) {
          const link = document.createElement("a");
          link.className = "vod-card__image";
          link.href = data.video.url;
          link.target = "_blank";
          link.rel = "noreferrer";
          const image = document.createElement("img");
          image.src = data.video.thumbnailUrl;
          image.alt = "";
          image.loading = "lazy";
          link.append(image);

          const details = document.createElement("div");
          details.className = "vod-card__copy";
          const chip = document.createElement("span");
          chip.className = "cute-chip";
          chip.textContent = `latest VOD · ${prettyDate(data.video.publishedAt)}`;
          const heading = document.createElement("h3");
          heading.textContent = data.video.title;
          const watch = document.createElement("a");
          watch.className = "button button--pink";
          watch.href = data.video.url;
          watch.target = "_blank";
          watch.rel = "noreferrer";
          watch.textContent = "watch the VOD ♡";
          details.append(chip, heading, watch);
          vodCard.replaceChildren(link, details);
        } else if (vodCard) {
          vodCard.innerHTML = `<div class="vod-card__placeholder"><i class="ph ph-twitch-logo" aria-hidden="true"></i></div><div class="vod-card__copy"><span class="cute-chip">Twitch VODs</span><h3>the newest one is on Twitch</h3><a class="button button--pink" href="https://www.twitch.tv/mochikolive/videos" target="_blank" rel="noreferrer">open VODs ♡</a></div>`;
        }
      } catch {
        if (statusText) statusText.textContent = "check Twitch ♡";
        if (vodCard) vodCard.innerHTML = `<div class="vod-card__placeholder"><i class="ph ph-twitch-logo" aria-hidden="true"></i></div><div class="vod-card__copy"><span class="cute-chip">Twitch VODs</span><h3>the newest one is on Twitch</h3><a class="button button--pink" href="https://www.twitch.tv/mochikolive/videos" target="_blank" rel="noreferrer">open VODs ♡</a></div>`;
      }
    };

    let externalContentLoaded = false;

    const showBlockedContent = () => {
      const statusText = document.querySelector("[data-stream-status] span");
      if (statusText) statusText.textContent = "not loaded";

      const grid = document.querySelector("[data-youtube-grid]");
      if (grid) grid.innerHTML = `<div class="privacy-locked-card"><i class="ph ph-lock-key" aria-hidden="true"></i><div><strong>YouTube is not loaded</strong><span>You said no to optional media. You can change that in privacy choices.</span></div><button type="button" data-open-privacy>change choice</button></div>`;

      const vodCard = document.querySelector("[data-vod-card]");
      if (vodCard) vodCard.innerHTML = `<div class="vod-card__placeholder"><i class="ph ph-lock-key" aria-hidden="true"></i></div><div class="vod-card__copy"><span class="cute-chip">not loaded</span><h3>Twitch is tucked away</h3><button class="button button--pink" type="button" data-open-privacy>privacy choices</button></div>`;
    };

    const maybeLoadExternalContent = () => {
      const choice = document.documentElement.dataset.privacyChoice;
      if (choice === "declined") {
        showBlockedContent();
        return;
      }
      if (choice !== "accepted" || externalContentLoaded) return;
      externalContentLoaded = true;

      const player = document.querySelector<HTMLIFrameElement>("[data-twitch-player]");
      const locked = document.querySelector<HTMLElement>("[data-embed-locked]");
      if (player?.dataset.src) player.src = player.dataset.src;
      if (locked) locked.hidden = true;

      loadYouTube();
      loadTwitch();
    };

    maybeLoadExternalContent();
    window.addEventListener("mochiko:privacy-choice", maybeLoadExternalContent);
  </script>
</BaseLayout>
